---
import MainLayout from "../layouts/MainLayout.astro";
import Button from "../components/Button.astro";
import { ARCHIVED_CASE_SLUGS, fetchPortfolioCases, NON_ACTIVE_CASE_SLUGS, type PortfolioCase } from "../data/portfolioCases";
import "../styles/global.css";

export async function getStaticPaths() {
  const projects = await fetchPortfolioCases();
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project, allProjects: projects },
  }));
}

const { project, allProjects } = Astro.props as { project: PortfolioCase; allProjects: PortfolioCase[] };

const sortedProjects = [...allProjects].sort((a, b) => a.id - b.id);
const navigationProjects = sortedProjects.filter((item) => !ARCHIVED_CASE_SLUGS.has(item.slug) && !NON_ACTIVE_CASE_SLUGS.has(item.slug));

const currentIndex = navigationProjects.findIndex((item) => item.slug === project.slug);

const prevProject = currentIndex > 0 ? navigationProjects[currentIndex - 1] : null;
const nextProject = currentIndex >= 0 && currentIndex < navigationProjects.length - 1 ? navigationProjects[currentIndex + 1] : null;

const DB_NOTICES: Record<string, { key: string; fallback: string }> = {
  kadaver: {
    key: "project.db.notice.showcase",
    fallback:
      "The database behind this project's live case showcase has been deactivated. The site may still display it for now, but the content is no longer being kept up to date.",
  },
  cpdanmark: {
    key: "project.db.notice.offline",
    fallback:
      "The database behind this project's live site has been deactivated. The site may still appear to work for now, but the content is no longer being kept up to date.",
  },
};
const dbNotice = DB_NOTICES[project.slug];

const FIGMA_PROTOTYPE_SLUGS = new Set(["vibeloop", "ungeforum", "pinterest-ai", "pace-duolingo", "folkaet"]);
const caseNote = dbNotice
  ? { key: dbNotice.key, text: dbNotice.fallback, tone: "warn" }
  : FIGMA_PROTOTYPE_SLUGS.has(project.slug)
    ? { key: "project.figma.notice", text: "This project is presented as an interactive prototype created in Figma", tone: "info" }
    : null;

const hasContext = Boolean(project.context?.trim());
const hasRole = Boolean(project.role?.trim());
const hasOutcome = Boolean(project.outcome?.trim());

const getDegreeLabel = (period?: string) => {
  const parts = (period ?? "")
    .split("·")
    .map((part) => part.trim())
    .filter(Boolean);
  return parts[parts.length - 1] || "";
};

const getPeriodWithoutDegree = (period?: string) => {
  const parts = (period ?? "")
    .split("·")
    .map((part) => part.trim())
    .filter(Boolean);
  return parts.length > 1 ? parts.slice(0, -1).join(" · ") : parts[0] || "";
};
---

<MainLayout
  title={`${project.name} | SRP Portfolio`}
  description={`${project.name} case study by Sara Ringkow Petersen. ${project.description}`}
  ogtitle={`${project.name} – SRP Portfolio`}
  ogdescription={`Explore the challenge, design process and outcome behind ${project.name}. ${project.description}`}
>
  <section id="project" class="relative grid grid-cols-12 max-w-6xl mx-auto pt-mobil-top md:mt-[5.5rem] mt-12 lg:px-0 px-6">
    <!-- Navigation -->
    <nav
      id="navigation"
      aria-label="Page navigation"
      data-i18n-aria="slugpage.nav.aria"
      class="col-span-12 grid grid-cols-3 items-center gap-2 md:mb-12 mb-10 md:pt-0 pt-10 text-[15px] md:text-p-desktop"
    >
      <div>
        {
          prevProject && prevProject.slug !== "no-project" && (
            <a
              href={`/${prevProject.slug}`}
              class="inline-block text-gray-500 hover:text-blue-400 hover:underline transition duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-300"
              aria-label={`Go to previous project: ${prevProject.name}`}
              data-project-nav-prefix="prev"
              data-project-nav-name={prevProject.name}
            >
              ←{" "}
              <>
                <span class="hidden md:inline">{prevProject.name}</span>
                <span class="md:hidden">Prev</span>
              </>
            </a>
          )
        }
      </div>

      <div class="text-center">
        <a
          href="/"
          class="inline-block text-gray-500 py-1 hover:text-blue-400 hover:underline transition duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-300"
          aria-label="Go to homepage"
          data-i18n-aria="header.logo.aria"
          data-i18n="project.back"
        >
          ↑ <span class="hidden md:inline">Homepage</span><span class="md:hidden">Home</span>
        </a>
      </div>

      <div class="text-right">
        {
          nextProject && nextProject.slug !== "no-project" && (
            <a
              href={`/${nextProject.slug}`}
              class="inline-block text-gray-500 py-1 hover:text-blue-400 hover:underline transition duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-300"
              aria-label={`Go to next project: ${nextProject.name}`}
              data-project-nav-prefix="next"
              data-project-nav-name={nextProject.name}
            >
              <>
                <span class="hidden md:inline">{nextProject.name}</span>
                <span class="md:hidden">Next</span>
              </>{" "}
              →
            </a>
          )
        }
      </div>
    </nav>

    <!-- Header -->
    <header id="project-header" class="case-hero-b col-span-12 md:mb-8 mb-6">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2 mb-4">
        <span
          id="project-degree"
          class="case-hero-chip"
          data-year={project.year || ""}
          data-year-da={project.year_da || ""}
        >
          {getDegreeLabel(project.year)}
        </span>
        <p
          id="project-subtitle"
          class="italic font-light text-[17px] md:text-h4-mobile leading-snug"
          data-semester={project.semester || ""}
          data-semester-da={project.semester_da || ""}
          data-year={project.year || ""}
          data-year-da={project.year_da || ""}
        >
          {project.year ? getPeriodWithoutDegree(project.year) : project.semester}
        </p>
      </div>
      <h1 id="project-title" class="font-nikumaru md:text-h2-desktop text-h4-desktop uppercase tracking-[0.14em] md:tracking-[0.18em] [overflow-wrap:anywhere]">
        {project.name}
      </h1>
    </header>

    <!-- Facts: context + role -->
    {
      (hasContext || hasRole) && (
        <div id="case-facts" class="col-span-12 grid md:grid-cols-2 grid-cols-1 gap-5 mb-6 lg:mb-8">
          {hasContext && (
            <section class:list={["case-fact", !hasRole && "md:col-span-2"]} aria-labelledby="case-context-label">
              <h2 id="case-context-label" class="case-fact-label" data-i18n="project.context">
                Context
              </h2>
              <p id="case-context" class="case-fact-text" data-value={project.context} data-value-da={project.context_da || ""}>
                {project.context}
              </p>
            </section>
          )}
          {hasRole && (
            <section class:list={["case-fact", !hasContext && "md:col-span-2"]} aria-labelledby="case-role-label">
              <h2 id="case-role-label" class="case-fact-label" data-i18n="project.role">
                Role
              </h2>
              <p id="case-role" class="case-fact-text" data-value={project.role} data-value-da={project.role_da || ""}>
                {project.role}
              </p>
            </section>
          )}
        </div>
      )
    }

    <!-- Content Grid -->
    <div class="col-span-12 grid lg:grid-cols-12 grid-cols-1 gap-6 lg:gap-8">
      <div class="lg:col-span-7">
        <img
          id="project-image"
          src={project.image}
          alt={project.name}
          class="w-full aspect-[4/3] rounded-3xl object-cover border border-gray-300"
          loading="lazy"
        />
      </div>

      <div class="lg:col-span-5 flex flex-col rounded-3xl border border-gray-300 bg-gradient-to-br from-gray-50 to-gray-100 p-6 md:p-8" id="project-details">
        <p
          id="project-description"
          class="text-gray-700 text-[1.05rem] leading-relaxed"
          data-description={project.description || ""}
          data-description-da={project.description_da || ""}
        >
          {project.description}
        </p>

        {
          project.tools && project.tools.length > 0 && (
            <div id="tools-list" class="mt-6">
              <h2 id="tools-title" class="text-sm font-semibold uppercase tracking-[0.12em] text-gray-600 mb-3" data-i18n="project.tools">
                Tools used:
              </h2>
              <ul class="flex flex-wrap gap-2" aria-labelledby="tools-title">
                {project.tools.map((tool) => (
                  <li class="fact-chip">{tool}</li>
                ))}
              </ul>
            </div>
          )
        }
        <div id="project-link" class="btn-container mt-auto pt-8">
          {
            caseNote && (
              <div id="case-note" class:list={["case-note", caseNote.tone === "warn" && "case-note-warn"]} role="note">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="case-note-icon" viewBox="0 0 16 16" aria-hidden="true">
                  <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16" />
                  <path d="M7.002 11a1 1 0 1 1 2 0 1 1 0 0 1-2 0M7.1 4.995a.905.905 0 1 1 1.8 0l-.35 3.507a.552.552 0 0 1-1.1 0z" />
                </svg>
                <p data-i18n={caseNote.key}>{caseNote.text}</p>
              </div>
            )
          }
          <Button
            href={project.url}
            target="_blank"
            rel="noopener noreferrer"
            variant="secondary"
            size="small"
            data-aria-en={`View project: ${project.name} (opens in new tab)`}
            data-aria-da={`Se projekt: ${project.name} (åbner i en ny fane)`}
            aria-label={`View project: ${project.name} (opens in new tab)`}><span data-i18n="project.view">View project</span></Button
          >
        </div>
      </div>
    </div>

    <!-- Outcome -->
    {
      hasOutcome && (
        <section id="case-outcome-tile" class="case-outcome col-span-12 mt-6 lg:mt-8" aria-labelledby="case-outcome-label">
          <h2 id="case-outcome-label" class="case-fact-label" data-i18n="project.outcome">
            Outcome
          </h2>
          <p id="case-outcome" class="case-outcome-text" data-value={project.outcome} data-value-da={project.outcome_da || ""}>
            {project.outcome}
          </p>
        </section>
      )
    }
  </section>

  <!-- Divider -->
  <div id="project-divider-1" class="max-w-6xl mx-auto lg:px-0 px-6 md:pt-20 pt-14 flex items-center gap-3 text-gray-300" aria-hidden="true">
    <span class="h-px flex-1 bg-gradient-to-r from-transparent via-current to-transparent opacity-70"></span>
    <span class="divider-center block h-2 w-2 rotate-45 border border-current/70 bg-white"></span>
    <span class="h-px flex-1 bg-gradient-to-r from-transparent via-current to-transparent opacity-70"></span>
  </div>

  <!-- Related Projects Section -->
  <section
    id="related-projects"
    class="max-w-6xl grid grid-cols-12 mx-auto md:pt-desktop-top pt-mobil-top md:pb-desktop-bottom pb-mobil-bottom lg:px-0 px-6"
  >
    <div id="related-projects-title" class="col-span-12">
      <div id="related-projects-title-row" class="flex items-center gap-4 mb-6">
        <h2
          class="font-garamond font-bold italic text-h3-mobile md:text-h3-desktop text-gray-800 md:text-left text-center"
          data-i18n="project.related.title"
        >
          More projects
        </h2>
      </div>
    </div>

    {
      (() => {
        const otherProjects = sortedProjects.filter(
          (p) => p.slug !== project.slug && !ARCHIVED_CASE_SLUGS.has(p.slug) && !NON_ACTIVE_CASE_SLUGS.has(p.slug),
        );
        const randomProjects = otherProjects.sort(() => 0.5 - Math.random()).slice(0, 3);
        return (
          <div class="col-span-12 grid grid-cols-1 lg:grid-cols-3 gap-6">
            {randomProjects.map((proj) => (
              <a
                href={`/${proj.slug}`}
                class="group block rounded-3xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-700 focus-visible:ring-offset-2 transition-all duration-300 ease-in-out hover:-translate-y-1"
              >
                <div class="related-project-card rounded-3xl overflow-hidden bg-gradient-to-br from-gray-50 to-gray-100 border border-gray-300 transition-all duration-300 ease-in-out group-hover:from-gray-100 group-hover:to-gray-200 group-hover:border-gray-400 group-focus-visible:-translate-y-1">
                  <img src={proj.image} alt={proj.name} class="w-full aspect-[4/3] sm:aspect-square md:aspect-[4/3] object-cover" loading="lazy" />
                  <div class="related-project-info p-5 border-t border-gray-300 transition-colors duration-300 group-hover:border-gray-400">
                    <h3 class="related-project-title text-h4-mobile font-semibold italic mb-2">{proj.name}</h3>
                    <p
                      class="related-project-year text-sm text-gray-600 transition-colors duration-300"
                      data-semester={proj.semester || ""}
                      data-semester-da={proj.semester_da || ""}
                      data-year={proj.year || ""}
                      data-year-da={proj.year_da || ""}
                    >
                      {proj.year || proj.semester}
                    </p>
                  </div>
                </div>
              </a>
            ))}
          </div>
        );
      })()
    }
  </section>
</MainLayout>

<style>
  .case-note {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    margin-bottom: 1.1rem;
    padding-top: 0.9rem;
    border-top: 1px solid #d8d2cc;
    color: #4b4b4b;
  }

  .case-note p {
    font-size: 0.875rem;
    line-height: 1.5;
    color: inherit;
  }

  .case-note-icon {
    flex-shrink: 0;
    margin-top: 0.1rem;
    color: #375567;
  }

  .case-note-warn {
    border-top: none;
    padding: 0.8rem 1rem;
    border-radius: 1rem;
    background: #ffedd5;
    color: #7c2d12;
  }

  .case-note-warn .case-note-icon {
    color: #9a3412;
  }

  body.dark .case-note {
    border-color: var(--dark-border);
    color: var(--text-on-dark-soft);
  }

  body.dark .case-note-icon {
    color: var(--brand-primary-soft);
  }

  body.dark .case-note-warn {
    background: rgba(249, 115, 22, 0.16);
    color: #ffedd5;
  }

  body.dark .case-note-warn .case-note-icon {
    color: #fdba74;
  }

  .case-fact,
  .case-outcome {
    border-radius: 1.5rem;
    padding: 1.5rem;
  }

  @media (min-width: 768px) {
    .case-fact,
    .case-outcome {
      padding: 1.75rem 2rem;
    }
  }

  .case-fact {
    border: 1px solid #d8d2cc;
    background: linear-gradient(to bottom right, #f5f5f5, #f0ebe6);
  }

  .case-outcome {
    border: 1px solid #c0d7e1;
    background: #deebef;
  }

  .case-fact-label,
  #tools-title {
    font-family: inherit;
    font-style: normal;
  }

  .case-fact-label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #375567;
    margin-bottom: 0.6rem;
  }

  .case-fact-text,
  .case-outcome-text {
    overflow-wrap: anywhere;
    hyphens: auto;
  }

  .case-fact-text {
    font-size: 1.1rem;
    line-height: 1.5;
    color: #1a1a1a;
  }

  .case-outcome-text {
    font-family: var(--font-garamond);
    font-style: italic;
    font-weight: 600;
    font-size: 1.45rem;
    line-height: 1.3;
    color: #1f2d37;
  }

  @media (min-width: 768px) {
    .case-outcome-text {
      font-size: 1.75rem;
    }
  }

  body.dark .case-fact,
  body.dark .case-outcome {
    border-color: var(--dark-border);
    background: linear-gradient(to bottom right, var(--dark-gradient-start), var(--dark-gradient-end));
  }

  body.dark .case-fact .case-fact-label,
  body.dark .case-outcome .case-fact-label {
    color: var(--text-on-dark-soft);
  }

  body.dark .case-fact .case-fact-text,
  body.dark .case-outcome .case-outcome-text {
    color: var(--text-on-dark);
  }

  body.dark #project-header h1,
  body.dark #project-header p,
  body.dark #tools-title {
    color: var(--text-on-dark);
  }

  body.dark #project-details {
    border-color: var(--dark-border);
    background: linear-gradient(to bottom right, var(--dark-gradient-start), var(--dark-gradient-end));
  }

  body.dark #project-description {
    color: var(--text-on-dark-soft);
  }

  body.dark a {
    color: var(--text-on-dark);
  }

  body.dark a:hover {
    color: var(--brand-primary-soft);
  }

  body.dark #project-image {
    border-color: var(--dark-border);
  }

  body.dark #project-divider-1 {
    color: var(--dark-border);
  }

  body.dark #project-divider-1 .divider-center {
    background-color: var(--dark-surface-strong);
    border-color: var(--dark-border);
  }

  body.dark section:last-child .col-span-12 > div > a > div {
    border-color: var(--dark-border);
    background: linear-gradient(to bottom right, var(--dark-gradient-start), var(--dark-gradient-end));
  }

  body.dark #related-projects h2 {
    color: var(--text-on-dark);
  }

  body.dark .related-project-card {
    border-color: var(--dark-border);
    background: linear-gradient(to bottom right, var(--dark-gradient-start), var(--dark-gradient-end));
  }

  body.dark .related-project-card:hover,
  body.dark .related-project-card:focus-visible {
    border-color: var(--dark-border-strong);
    background: linear-gradient(to bottom right, #3a3a3a, #2a2a2a);
  }

  body.dark .related-project-info {
    border-color: var(--dark-border);
  }

  body.dark .related-project-title {
    color: var(--text-on-dark);
  }

  body.dark .related-project-year {
    color: var(--text-on-dark-soft);
  }
</style>

<script>
  const applyDatabaseTranslations = (lang: string) => {
    const descriptionEl = document.querySelector("#project-description") as HTMLElement | null;
    const subtitleEl = document.querySelector("#project-subtitle") as HTMLElement | null;

    if (descriptionEl) {
      const description = descriptionEl.dataset.description || "";
      const descriptionDa = descriptionEl.dataset.descriptionDa || "";
      const currentDescription = lang === "da" ? descriptionDa || description : description;
      descriptionEl.textContent = currentDescription;
    }

    const getFullCurrentPeriod = (el: HTMLElement) => {
      const year = el.dataset.year || "";
      const yearDa = el.dataset.yearDa || "";
      const semester = el.dataset.semester || "";
      const semesterDa = el.dataset.semesterDa || "";

      const currentYear = lang === "da" ? yearDa || year : year;
      const currentSemester = lang === "da" ? semesterDa || semester : semester;

      return currentYear || currentSemester;
    };

    if (subtitleEl) {
      const year = subtitleEl.dataset.year || "";
      const yearDa = subtitleEl.dataset.yearDa || "";
      const currentYear = lang === "da" ? yearDa || year : year;
      if (currentYear) {
        const parts = currentYear
          .split("·")
          .map((part) => part.trim())
          .filter(Boolean);
        subtitleEl.textContent = parts.length > 1 ? parts.slice(0, -1).join(" · ") : parts[0] || "";
      } else {
        subtitleEl.textContent = getFullCurrentPeriod(subtitleEl);
      }
    }

    ["#case-context", "#case-role", "#case-outcome"].forEach((selector) => {
      const el = document.querySelector(selector) as HTMLElement | null;
      if (!el) return;
      const value = el.dataset.value || "";
      const valueDa = el.dataset.valueDa || "";
      el.textContent = lang === "da" ? valueDa || value : value;
    });

    const degreeEl = document.querySelector("#project-degree") as HTMLElement | null;
    if (degreeEl) {
      const year = degreeEl.dataset.year || "";
      const yearDa = degreeEl.dataset.yearDa || "";
      const currentYear = lang === "da" ? yearDa || year : year;
      const parts = currentYear
        .split("·")
        .map((part) => part.trim())
        .filter(Boolean);
      degreeEl.textContent = parts[parts.length - 1] || "";
    }

    document.querySelectorAll(".related-project-year").forEach((yearEl) => {
      const element = yearEl as HTMLElement;
      element.textContent = getFullCurrentPeriod(element);
    });

    // Prev/next case-study nav: aria-label interpolates the project name, so it can't
    // use a plain data-i18n-aria lookup — rebuild it from the translated prefix instead.
    const prefixes: Record<string, { en: string; da: string }> = {
      prev: { en: "Go to previous project", da: "Gå til forrige projekt" },
      next: { en: "Go to next project", da: "Gå til næste projekt" },
    };
    document.querySelectorAll<HTMLElement>("[data-project-nav-prefix]").forEach((el) => {
      const prefixKey = el.dataset.projectNavPrefix as "prev" | "next" | undefined;
      const name = el.dataset.projectNavName;
      if (!prefixKey || !name || !prefixes[prefixKey]) return;
      const prefix = lang === "da" ? prefixes[prefixKey].da : prefixes[prefixKey].en;
      el.setAttribute("aria-label", `${prefix}: ${name}`);
    });
  };

  const getLang = () => localStorage.getItem("lang") || "en";

  const syncDatabaseTranslations = () => {
    applyDatabaseTranslations(getLang());
  };

  syncDatabaseTranslations();

  document.addEventListener("astro:page-load", () => {
    syncDatabaseTranslations();
  });

  window.addEventListener("langchange", (event: Event) => {
    const customEvent = event as CustomEvent;
    const lang = customEvent.detail?.lang || getLang();
    applyDatabaseTranslations(lang);
  });
</script>
