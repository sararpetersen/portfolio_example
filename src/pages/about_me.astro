---
import MainLayout from "../layouts/MainLayout.astro";
import "../styles/global.css";
import Button from "../components/Button.astro";

interface TimelineItem {
  i18nKey: number;
  category: "school" | "work";
  year: string;
  title: string;
  desc: string;
  note?: string;
}

const timelineItems: TimelineItem[] = [
  {
    i18nKey: 0,
    category: "school",
    year: "August 2019 - June 2021",
    title: "HF (higher preparatory examination) | Egedal Gymnasium & HF",
    desc: "Completed high school with a focus on art, social studies and psychology, which sparked my interest in creativity, people and communication.",
  },
  {
    i18nKey: 5,
    category: "work",
    year: "January 2026 - June 2026",
    title: "Student Buddy | Academy of Technologies and Business (Zealand)",
    desc: "Supporting international students through onboarding, social and academic integration, and acting as a go-to contact for everyday questions.",
  },
  {
    i18nKey: 2,
    category: "school",
    year: "August 2023 - June 2025",
    title: "Multimedia Design | Copenhagen School of Design and Technology (KEA)",
    desc: "Worked with UX/UI, digital design and coding, and gained hands-on experience with design tools, prototyping and web projects.",
  },
  {
    i18nKey: 3,
    category: "work",
    year: "January 2025 - April 2025",
    title: "Junior Creative/Intern | Kadaver ApS",
    desc: "Worked on website redesigns, developed sitemaps and information architecture, and created maintenance documentation for clients.",
  },
  {
    i18nKey: 4,
    category: "school",
    year: "Present",
    title: "Digital Concept Development | Academy of Technologies and Business (Zealand)",
    desc: "Currently studying how to turn ideas into user-focused digital concepts, with a strong focus on strategic and behavioural design.",
  },
  {
    i18nKey: 6,
    category: "work",
    year: "May 2026 - Present",
    title: "Software Developer Intern | Folkæt",
    desc: "Working on an accessibility-focused page for neurodivergent users, alongside design tasks in Figma and learning React Router 7 and Python through minor tasks on Folkæt's platform.",
  },
];

const isCurrentItem = (yearRange: string) => yearRange.toLowerCase().includes("present");

// Newest first.
const chronologicalOrder = [0, 2, 3, 4, 5, 6];
const newestFirst = [...timelineItems].sort((x, y) => chronologicalOrder.indexOf(y.i18nKey) - chronologicalOrder.indexOf(x.i18nKey));
const schoolTimelineItems = newestFirst.filter((item) => item.category === "school");
const workTimelineItems = newestFirst.filter((item) => item.category === "work");
---

<MainLayout
  title="About Sara | SRP Portfolio"
  description="Meet Sara Ringkow Petersen, a Danish concept developer, multimedia- and UX/UI designer specialising in digital accessibility and neurodivergent user needs."
  ogtitle="About Sara Ringkow Petersen – SRP Portfolio"
  ogdescription="Concept developer, multimedia- and UX/UI designer specialising in digital accessibility, informed by lived experience of neurodivergence."
>
  <!-- Top Section -->
  <section id="about-me" class="grid grid-cols-12 md:pt-desktop-top pt-mobil-top md:mt-16 mt-8 xl:px-0 px-6 mx-auto relative container max-w-6xl">
    <div class="relative col-span-12 md:pt-12 pt-16 mb-12">
      <div id="about-title-row" class="mb-3">
        <h1
          class="heading-title uppercase tracking-[0.14em] md:tracking-[0.18em] font-nikumaru text-[1.85rem] md:text-h2-desktop [overflow-wrap:anywhere]"
          data-i18n="about.title"
        >
          About me
        </h1>
      </div>
      <p class="heading-text text-gray-600 max-w-3xl text-left" data-i18n="about.intro">
        Expand a section below to read about my background, what inspires me, and where I'm heading.<br class="hidden md:block" /> Scroll further down to
        explore my journey, interests, and downloadable resources.
      </p>
    </div>
  </section>

  <!-- Personal Background -->
  <section id="personal-background" class="container grid grid-cols-12 px-6 max-w-6xl mx-auto xl:px-0">
    <div class="grid lg:grid-cols-2 grid-cols-1 lg:items-start items-center justify-center col-span-12 gap-10 lg:gap-12">
      <div id="personal-background-content" class="md:pb-0 pb-8">
        <h2 class="sr-only" data-i18n="about.personalBackground.title">Personal background</h2>
        <div class="flex flex-col gap-4">
          <div class="acc-item personal-bg-item">
            <h3 class="acc-heading">
              <button type="button" id="acc-trigger-background" class="accordion-trigger" aria-expanded="false" aria-controls="acc-background">
                <span class="acc-num" aria-hidden="true">01</span>
                <span class="acc-title" data-i18n="about.tab.background">Background</span>
                <span class="acc-chevron" aria-hidden="true">
                  <svg
                    class="accordion-chevron w-4 h-4"
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="2"
                    stroke="currentColor"
                    aria-hidden="true"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"></path>
                  </svg>
                </span>
              </button>
            </h3>
            <div id="acc-background" class="accordion-panel" role="region" aria-labelledby="acc-trigger-background">
              <div>
                <p class="acc-text" data-i18n="about.background.text">
                  I've always been drawn to creativity – drawing, painting, just making stuff in general. I knew fairly early on that, someday, I
                  wanted that to be part of my career. As I got older, however, I also became interested in technology, so I spent a long time trying
                  to figure out how to combine the two. Multimedia Design is where those things came together. It gave me a way to work with both
                  design and technology, and to think carefully about how things are built, and not just how they look.
                </p>
              </div>
            </div>
          </div>
          <div class="acc-item personal-bg-item">
            <h3 class="acc-heading">
              <button type="button" id="acc-trigger-inspiration" class="accordion-trigger" aria-expanded="false" aria-controls="acc-inspiration">
                <span class="acc-num" aria-hidden="true">02</span>
                <span class="acc-title" data-i18n="about.tab.inspiration">Inspiration</span>
                <span class="acc-chevron" aria-hidden="true">
                  <svg
                    class="accordion-chevron w-4 h-4"
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="2"
                    stroke="currentColor"
                    aria-hidden="true"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"></path>
                  </svg>
                </span>
              </button>
            </h3>
            <div id="acc-inspiration" class="accordion-panel" role="region" aria-labelledby="acc-trigger-inspiration">
              <div>
                <p class="acc-text" data-i18n="about.inspiration.text">
                  As someone who's late-diagnosed with autism and ADD, I know what it's like to use digital platforms that weren't built with you in
                  mind. My neurodivergent perspective shapes the way I think about accessibility, structure, and user needs. Rather than a checklist,
                  it's something that runs through the whole process. I care about making things easier to understand, navigate, and use. And I find
                  that the small decisions&mdash; a clear label, a consistent layout, a well-structured page &mdash;often matter more than people
                  expect.
                </p>
              </div>
            </div>
          </div>
          <div class="acc-item personal-bg-item">
            <h3 class="acc-heading">
              <button type="button" id="acc-trigger-goals" class="accordion-trigger" aria-expanded="false" aria-controls="acc-goals">
                <span class="acc-num" aria-hidden="true">03</span>
                <span class="acc-title" data-i18n="about.tab.goals">Goals</span>
                <span class="acc-chevron" aria-hidden="true">
                  <svg
                    class="accordion-chevron w-4 h-4"
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="2"
                    stroke="currentColor"
                    aria-hidden="true"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"></path>
                  </svg>
                </span>
              </button>
            </h3>
            <div id="acc-goals" class="accordion-panel" role="region" aria-labelledby="acc-trigger-goals">
              <div>
                <p class="acc-text" data-i18n="about.goals.text">
                  I want to work on digital things that are genuinely accessible – not just technically compliant, but usable for real people. I care
                  about getting the details right: structure, clarity, and the parts users actually interact with. Right now I'm building that through
                  studying, working, and making things. My aim is to keep doing that in a context where good design actually matters.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="flex items-center justify-center lg:justify-end">
        <img
          src="/images/pfp2.webp"
          alt="Portrait of Sara (taken during the internship at Kadaver)"
          class="portrait lg:w-[400px] w-[250px] lg:h-[450px] h-[300px] object-cover"
          width="400"
          height="450"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- Timeline -->
  <section id="timeline" class="container max-w-6xl mx-auto xl:px-0 px-6 md:pt-desktop-top pt-mobil-top">
    <h2 id="timeline-title" class="font-garamond italic font-bold text-h3-mobile md:text-h3-desktop text-gray-800 pb-6" data-i18n="timeline.title">
      The highlights of my journey
    </h2>
    <div class="tl-columns">
      <div>
        <h3 class="tl-column-label">
          <span class="tl-dot tl-dot-school" aria-hidden="true"></span><span data-i18n="timeline.education">Education</span>
        </h3>
        <ol class="tl-list">
          {
            schoolTimelineItems.map((item) => (
              <li class="tl-row">
                <p class="tl-year" data-i18n={`timeline.${item.i18nKey}.year`}>
                  {item.year}
                </p>
                <h4 class="tl-title" data-i18n={`timeline.${item.i18nKey}.title`}>
                  {item.title}
                </h4>
                <p class="tl-desc" data-i18n={`timeline.${item.i18nKey}.desc`}>
                  {item.desc}
                </p>
              </li>
            ))
          }
        </ol>
      </div>
      <div>
        <h3 class="tl-column-label">
          <span class="tl-dot tl-dot-work" aria-hidden="true"></span><span data-i18n="timeline.work">Work experience</span>
        </h3>
        <ol class="tl-list">
          {
            workTimelineItems.map((item) => (
              <li class="tl-row">
                <p class="tl-year" data-i18n={`timeline.${item.i18nKey}.year`}>
                  {item.year}
                </p>
                <h4 class="tl-title" data-i18n={`timeline.${item.i18nKey}.title`}>
                  {item.title}
                </h4>
                <p class="tl-desc" data-i18n={`timeline.${item.i18nKey}.desc`}>
                  {item.desc}
                </p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- Interests and Hobbies -->
  <section id="interests" class="max-w-6xl mx-auto xl:px-0 px-6 md:pt-desktop-top pt-mobil-top">
    <h2 id="interests-title" class="font-garamond italic font-bold text-h3-mobile md:text-h3-desktop text-gray-800 mb-6" data-i18n="interests.title">
      Interests and hobbies
    </h2>
    <ul id="interests-and-hobbies" class="plain-grid">
      <li class="plain-item">
        <h3 class="plain-title" data-i18n="interest.japanese.title">Japanese culture</h3>
        <p class="plain-text" data-i18n="interest.japanese.text">I love the balance between simplicity, detail, and thoughtful storytelling.</p>
      </li>
      <li class="plain-item">
        <h3 class="plain-title" data-i18n="interest.lego.title">Building with LEGO</h3>
        <p class="plain-text" data-i18n="interest.lego.text">My creative outlet that doesn't require a screen.</p>
      </li>
      <li class="plain-item">
        <h3 class="plain-title" data-i18n="interest.themepark.title">Theme parks and attractions</h3>
        <p class="plain-text" data-i18n="interest.themepark.text">
          Something that somehow became a real passion. I love keeping up with the world of theme parks, their attractions, and the stories behind
          them.
        </p>
      </li>
    </ul>
  </section>

  <!-- Resources Section -->
  <section id="resources" class="resources-section max-w-6xl mx-auto xl:px-0 px-6 md:pt-desktop-top pt-mobil-top">
    <h2
      id="resources-title"
      class="font-garamond font-semibold italic text-h3-mobile md:text-h3-desktop text-gray-800 mb-6"
      data-i18n="resources.title"
    >
      Resources
    </h2>
    <ul id="resources-section" class="plain-list">
      <li class="plain-item resource-row">
        <h3 class="plain-title" data-i18n="resource.resume.en.title">Resume (EN)</h3>
        <span class="self-start">
          <Button
            href="/pdfs/CV_sararpetersen_(EN).pdf"
            target="_blank"
            rel="noopener noreferrer"
            variant="secondary"
            size="small"
            aria-label="See resume (EN, opens in new tab)"
            data-i18n-aria="resource.resume.en.aria"><span data-i18n="resource.resume.en.btn">View resume</span></Button
          >
        </span>
      </li>
      <li class="plain-item resource-row">
        <h3 class="plain-title" data-i18n="resource.cv.da.title">CV (DA)</h3>
        <span class="self-start">
          <Button
            href="/pdfs/CV_sararpetersen_(DA).pdf"
            target="_blank"
            rel="noopener noreferrer"
            variant="secondary"
            size="small"
            aria-label="See CV (DA, opens in new tab)"
            data-i18n-aria="resource.cv.da.aria"><span data-i18n="resource.cv.da.btn">View CV</span></Button
          >
        </span>
      </li>
    </ul>
  </section>

  <!-- Navigation Back to Portfolio -->
  <section class="button-container mx-auto py-20 text-center">
    <Button href="/" variant="primary" size="small"><span data-i18n="btn.back">Back to homepage</span></Button>
  </section>
</MainLayout>

<!-- Accordion script -->
<script>
  document.addEventListener("DOMContentLoaded", () => {
    document.querySelectorAll<HTMLButtonElement>(".accordion-trigger").forEach((trigger) => {
      const panelId = trigger.getAttribute("aria-controls");
      if (!panelId) return;
      const panel = document.getElementById(panelId);
      if (!panel) return;

      trigger.addEventListener("click", () => {
        const isExpanded = trigger.getAttribute("aria-expanded") === "true";
        trigger.setAttribute("aria-expanded", String(!isExpanded));
        panel.classList.toggle("open", !isExpanded);
      });
    });
  });
</script>

<!-- CSS -->
<style>
  /* Accordion tiles */
  .acc-item {
    border: 1px solid #d8d2cc;
    border-radius: 1.5rem;
    background: linear-gradient(to bottom right, #f5f5f5, #f0ebe6);
    transition:
      background-color 0.3s ease,
      border-color 0.3s ease;
  }

  .acc-item:has(.accordion-trigger[aria-expanded="true"]) {
    border-color: #c0d7e1;
    background: #deebef;
  }

  .acc-heading {
    margin: 0;
  }

  .accordion-trigger {
    display: flex;
    align-items: center;
    gap: 1rem;
    width: 100%;
    padding: 1.25rem 1.5rem;
    border: none;
    border-radius: 1.5rem;
    background: none;
    color: inherit;
    text-align: left;
    cursor: pointer;
  }

  .accordion-trigger:focus-visible {
    outline: 3px solid #375567;
    outline-offset: 2px;
  }

  .acc-num {
    flex-shrink: 0;
    border-radius: 9999px;
    background: #deebef;
    color: #2f3f4c;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    padding: 0.35rem 0.7rem;
  }

  .accordion-trigger[aria-expanded="true"] .acc-num {
    background: #375567;
    color: #f5f5f5;
  }

  .acc-title {
    flex: 1;
    font-family: var(--font-garamond);
    font-style: italic;
    font-weight: 600;
    font-size: 1.5rem;
    line-height: 1.2;
    color: #1a1a1a;
  }

  @media (min-width: 768px) {
    .acc-title {
      font-size: 1.85rem;
    }
  }

  .acc-chevron {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid #8f8882;
    border-radius: 9999px;
    color: #375567;
  }

  .accordion-chevron {
    transition: transform 0.3s ease;
  }

  .accordion-trigger[aria-expanded="true"] .accordion-chevron {
    transform: rotate(180deg);
  }

  .accordion-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.35s ease;
    overflow: hidden;
  }

  .accordion-panel.open {
    grid-template-rows: 1fr;
  }

  .accordion-panel > div {
    overflow: hidden;
  }

  .acc-text {
    max-width: 70ch;
    padding: 0 1.5rem 1.5rem;
    font-size: 1.0625rem;
    line-height: 1.75;
    color: #2e2e2e;
  }

  @media (min-width: 768px) {
    .acc-text {
      padding: 0 1.5rem 1.75rem 4.6rem;
    }
  }

  /* Timeline: two open columns, hairline-separated entries, no container */
  .tl-columns {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 768px) {
    .tl-columns {
      grid-template-columns: 1fr 1fr;
      gap: 3.5rem;
    }
  }

  .tl-column-label {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.25rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #1a1a1a;
  }

  .tl-dot {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 9999px;
  }

  .tl-dot-school {
    border: 2px solid #375567;
    background: #deebef;
  }

  .tl-dot-work {
    border: 2px solid #a8412d;
    background: #f3b9ae;
  }

  .tl-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid #d8d2cc;
  }

  .tl-row {
    padding: 1.25rem 0;
    border-bottom: 1px solid #d8d2cc;
  }

  .tl-year {
    margin-bottom: 0.3rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.4;
    text-transform: uppercase;
    color: #375567;
  }

  .tl-title {
    margin-bottom: 0.35rem;
    font-family: var(--font-almarai);
    font-weight: 700;
    font-size: 1.05rem;
    line-height: 1.4;
    color: #1a1a1a;
  }

  .tl-desc {
    max-width: 62ch;
    font-size: 0.95rem;
    line-height: 1.65;
    color: #2e2e2e;
  }

  /* Interests and resources: plain columns with a hairline on top, same language as the timeline */
  .plain-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0 3rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 768px) {
    .plain-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .plain-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid #d8d2cc;
  }

  .resource-row {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem 0;
  }

  @media (min-width: 768px) {
    .resource-row {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 0;
      padding: 1.25rem 0;
    }
  }

  .resource-row .plain-title {
    margin-bottom: 0;
  }

  .plain-item {
    padding: 1.25rem 0 1.5rem;
    border-top: 1px solid #d8d2cc;
  }

  .plain-title {
    margin-bottom: 0.4rem;
    font-family: var(--font-garamond);
    font-style: italic;
    font-weight: 600;
    font-size: 1.65rem;
    line-height: 1.15;
    color: #1a1a1a;
  }

  .plain-text {
    font-size: 0.95rem;
    line-height: 1.65;
    color: #2e2e2e;
  }

  body.dark .tl-list,
  body.dark .tl-row {
    border-color: var(--dark-border);
  }

  body.dark .tl-year {
    color: var(--brand-primary-soft);
  }

  body.dark .tl-column-label {
    color: var(--text-on-dark);
  }

  body.dark .tl-dot-school {
    border-color: #c0d7e1;
    background: rgba(192, 215, 225, 0.3);
  }

  body.dark .tl-dot-work {
    border-color: #f3b9ae;
    background: rgba(243, 185, 174, 0.3);
  }

  body.dark .tl-title {
    color: var(--text-on-dark);
  }

  body.dark .tl-desc {
    color: var(--text-on-dark-soft);
  }

  body.dark .plain-item,
  body.dark .plain-list {
    border-color: var(--dark-border);
  }

  body.dark .plain-title {
    color: var(--text-on-dark);
  }

  body.dark .plain-text {
    color: var(--text-on-dark-soft);
  }

  .portrait {
    border: 1px solid #d8d2cc;
    border-radius: 1.5rem;
  }

  body.dark .portrait {
    border-color: var(--dark-border);
  }

  body.dark .acc-item {
    border-color: var(--dark-border);
    background: linear-gradient(to bottom right, var(--dark-gradient-start), var(--dark-gradient-end));
  }

  body.dark .acc-item:has(.accordion-trigger[aria-expanded="true"]) {
    border-color: rgba(192, 215, 225, 0.35);
    background: linear-gradient(to bottom right, rgba(192, 215, 225, 0.16), rgba(192, 215, 225, 0.07));
  }

  body.dark .acc-item .acc-title {
    color: var(--text-on-dark);
  }

  body.dark .acc-item .acc-text {
    color: var(--text-on-dark-soft);
  }

  body.dark .acc-item .acc-num {
    background: rgba(192, 215, 225, 0.18);
    color: var(--text-on-dark);
  }

  body.dark .acc-item .accordion-trigger[aria-expanded="true"] .acc-num {
    background: #f5f5f5;
    color: #1a1a1a;
  }

  body.dark .acc-item .acc-chevron {
    border-color: var(--dark-border-strong);
    color: var(--brand-primary-soft);
  }

  body.dark .accordion-trigger:focus-visible {
    outline-color: var(--brand-primary-soft);
  }

  /* Pre-animation: hide elements until JS fires */
  html.has-js body:not(.reduce-motion) #about-title-row,
  html.has-js body:not(.reduce-motion) .heading-text,
  html.has-js body:not(.reduce-motion) #timeline-title,
  html.has-js body:not(.reduce-motion) .personal-bg-item,
