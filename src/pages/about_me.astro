---
import MainLayout from "../layouts/MainLayout.astro";
import "../styles/global.css";
import Button from "../components/Button.astro";

interface TimelineItem {
  i18nKey: number;
  category: "school" | "work";
  year: string;
  title: string;
  desc: string;
  note?: string;
}

const timelineItems: TimelineItem[] = [
  {
    i18nKey: 0,
    category: "school",
    year: "August 2019 - June 2021",
    title: "HF | Egedal Gymnasium & HF",
    desc: "Completed high school with a focus on art, social studies and psychology, which sparked my interest in creativity, people and communication.",
  },
  {
    i18nKey: 5,
    category: "work",
    year: "January 2026 - June 2026",
    title: "Student Buddy | Academy of Technologies and Business (Zealand)",
    desc: "Supporting international students through onboarding, social and academic integration, and acting as a go-to contact for everyday questions.",
  },
  {
    i18nKey: 2,
    category: "school",
    year: "August 2023 - June 2025",
    title: "Multimedia Design | Copenhagen School of Design and Technology (KEA)",
    desc: "Worked with UX/UI, digital design and coding, and gained hands-on experience with design tools, prototyping and web projects.",
  },
  {
    i18nKey: 3,
    category: "work",
    year: "January 2025 - April 2025",
    title: "Junior Creative/Intern | Kadaver ApS",
    desc: "Worked on website redesigns, developed sitemaps and information architecture, and created maintenance documentation for clients.",
  },
  {
    i18nKey: 4,
    category: "school",
    year: "Present",
    title: "Digital Concept Development | Academy of Technologies and Business (Zealand)",
    desc: "Currently studying how to turn ideas into user-focused digital concepts, with a strong focus on strategic and behavioural design.",
  },
  {
    i18nKey: 6,
    category: "work",
    year: "May 2026 - Present",
    title: "Software Developer Intern | Folkæt",
    desc: "Working on an accessibility-focused page for neurodivergent users, alongside design tasks in Figma and learning React Router 7 through minor tasks on Folkæt's platform.",
  },
];

const getTimelineSortValue = (yearRange: string) => {
  if (yearRange.toLowerCase().includes("present")) return 9999;

  const years = yearRange.match(/\d{4}/g);
  if (!years || years.length === 0) return 0;

  return Number(years[years.length - 1]);
};

const schoolTimelineItems = timelineItems
  .filter((item) => item.category === "school")
  .sort((a, b) => getTimelineSortValue(b.year) - getTimelineSortValue(a.year));

const workTimelineItems = timelineItems
  .filter((item) => item.category === "work")
  .sort((a, b) => getTimelineSortValue(b.year) - getTimelineSortValue(a.year));
---

<MainLayout
  title="About Sara | SRP Portfolio"
  description="Meet Sara Ringkow Petersen, a Danish concept developer, multimedia- and UX/UI designer specialising in digital accessibility and neurodivergent user needs."
  ogtitle="About Sara Ringkow Petersen – SRP Portfolio"
  ogdescription="Concept developer, multimedia- and UX/UI designer specialising in digital accessibility, informed by lived experience of neurodivergence."
>
  <!-- Top Section -->
  <section id="about-me" class="grid grid-cols-12 gap-x-0 gap-y-10 items-center md:pt-desktop-top pt-mobil-top md:mt-16 mt-8 mb-12 lg:px-0 px-6 mx-auto relative container max-w-6xl">
    <div class="relative col-span-12 lg:col-span-7 md:pt-12 pt-16 lg:pr-10">
      <div id="about-title-row" class="mb-3">
        <h1
          class="heading-title uppercase tracking-[0.14em] md:tracking-[0.18em] font-nikumaru text-[1.85rem] md:text-h2-desktop [overflow-wrap:anywhere]"
          data-i18n="about.title"
        >
          About me
        </h1>
      </div>
      <p class="heading-text text-gray-600 max-w-3xl text-left" data-i18n="about.intro">
        Expand a section below to read about my background, what inspires me, and where I'm heading.<br class="hidden md:block" /> Scroll further down to
        explore my journey, interests, and downloadable resources.
      </p>
    </div>

    <div id="about-portrait" class="col-span-12 lg:col-span-5 flex justify-center lg:justify-end lg:pr-4">
      <div class="about-portrait-frame portrait-frame">
        <img
          src="/images/pfp2.webp"
          alt="Portrait of Sara (taken during the internship at Kadaver)"
          class="about-portrait-img"
          width="400"
          height="450"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <!-- Personal Background -->
  <section id="personal-background" class="container grid grid-cols-12 px-6 max-w-6xl mx-auto lg:px-0">
    <div id="personal-background-content" class="col-span-12">
      <h2 class="sr-only" data-i18n="about.personalBackground.title">Personal background</h2>
      <div class="flex flex-col gap-4">
      <div class="acc-item personal-bg-item">
        <h3 class="acc-heading">
          <button type="button" id="acc-trigger-background" class="accordion-trigger" aria-expanded="false" aria-controls="acc-background">
            <span class="acc-num" aria-hidden="true">01</span>
            <span class="acc-title" data-i18n="about.tab.background">Background</span>
            <span class="acc-chevron" aria-hidden="true">
              <svg
                class="accordion-chevron w-4 h-4"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="2"
                stroke="currentColor"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"></path>
              </svg>
            </span>
          </button>
        </h3>
        <div id="acc-background" class="accordion-panel" role="region" aria-labelledby="acc-trigger-background">
          <div>
            <p class="acc-text" data-i18n="about.background.text">
              I've always been drawn to creativity&mdash; drawing, painting, just making stuff in general. I knew fairly early on that, someday, I wanted that to be part of my career. As I got older, however, I also became interested in technology, so I spent a long time trying to figure out how to combine the two. Multimedia Design is where those things came together. It gave me a way to work with both design and technology, and to think carefully about how things are built, and not just how they look.
            </p>
          </div>
        </div>
      </div>
      <div class="acc-item personal-bg-item">
        <h3 class="acc-heading">
          <button type="button" id="acc-trigger-inspiration" class="accordion-trigger" aria-expanded="false" aria-controls="acc-inspiration">
            <span class="acc-num" aria-hidden="true">02</span>
            <span class="acc-title" data-i18n="about.tab.inspiration">Inspiration</span>
            <span class="acc-chevron" aria-hidden="true">
              <svg
                class="accordion-chevron w-4 h-4"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="2"
                stroke="currentColor"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"></path>
              </svg>
            </span>
          </button>
        </h3>
        <div id="acc-inspiration" class="accordion-panel" role="region" aria-labelledby="acc-trigger-inspiration">
          <div>
            <p class="acc-text" data-i18n="about.inspiration.text">
              As someone who's late-diagnosed with autism and ADD, I know what it's like to use digital platforms that weren't built with you in mind. My neurodivergent perspective shapes the way I think about accessibility, structure, and user needs. Rather than a checklist, it's something that runs through the whole process. I care about making things easier to understand, navigate, and use. And I find that the small decisions&mdash; a clear label, a consistent layout, a well-structured page &mdash;often matter more than people expect.
            </p>
          </div>
        </div>
      </div>
      <div class="acc-item personal-bg-item">
        <h3 class="acc-heading">
          <button type="button" id="acc-trigger-goals" class="accordion-trigger" aria-expanded="false" aria-controls="acc-goals">
            <span class="acc-num" aria-hidden="true">03</span>
            <span class="acc-title" data-i18n="about.tab.goals">Goals</span>
            <span class="acc-chevron" aria-hidden="true">
              <svg
                class="accordion-chevron w-4 h-4"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="2"
                stroke="currentColor"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"></path>
              </svg>
            </span>
          </button>
        </h3>
        <div id="acc-goals" class="accordion-panel" role="region" aria-labelledby="acc-trigger-goals">
          <div>
            <p class="acc-text" data-i18n="about.goals.text">
              I want to work on digital things that are genuinely accessible&mdash; not just technically compliant, but usable for real people. I care about getting the details right: structure, clarity, and the parts users actually interact with. Right now I'm building that through studying, working, and making things. My aim is to keep doing that in a context where good design actually matters.
            </p>
          </div>
        </div>
      </div>
      </div>
    </div>
  </section>

  <!-- Divider -->
  <div id="about-divider-1" class="max-w-6xl mx-auto lg:px-0 px-6 md:pt-20 pt-14 flex items-center gap-3 text-gray-300" aria-hidden="true">
    <span class="h-px flex-1 bg-gradient-to-r from-transparent via-current to-transparent opacity-70"></span>
    <span class="divider-center block h-2 w-2 rotate-45 border border-current/70 bg-white"></span>
    <span class="h-px flex-1 bg-gradient-to-r from-transparent via-current to-transparent opacity-70"></span>
  </div>

  <!-- Timeline -->
  <section id="timeline" class="container max-w-6xl mx-auto lg:px-0 px-6 md:pt-desktop-top pt-mobil-top">
    <h2 id="timeline-title" class="font-garamond italic font-bold text-h3-mobile md:text-h3-desktop text-gray-800 pb-6" data-i18n="timeline.title">
      The highlights of my journey
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-10">
      <div>
        <h3 class="timeline-column-label font-garamond italic font-semibold text-base text-gray-800 mb-4" data-i18n="timeline.education">
          Education
        </h3>
        <div class="flex flex-col">
          {
            schoolTimelineItems.map((item) => (
              <div class="timeline-item border-t-2 border-gray-200 pt-5 pb-5 last:pb-0">
                <p class="text-[11px] font-semibold text-gray-500 mb-1 uppercase tracking-widest" data-i18n={`timeline.${item.i18nKey}.year`}>
                  {item.year}
                </p>
                <h4 class="font-bold text-[15px] leading-snug mb-1 font-almarai" data-i18n={`timeline.${item.i18nKey}.title`}>
                  {item.title}
                </h4>
                <p class="text-gray-500 text-sm leading-relaxed" data-i18n={`timeline.${item.i18nKey}.desc`}>
                  {item.desc}
                </p>
                {item.note && (
                  <p class="italic text-gray-600 text-xs mt-2" data-i18n={`timeline.${item.i18nKey}.note`}>
                    {item.note}
                  </p>
                )}
              </div>
            ))
          }
        </div>
      </div>

      <div>
        <h3 class="timeline-column-label font-garamond italic font-semibold text-base text-gray-800 mb-4" data-i18n="timeline.work">
          Work experience
        </h3>
        <div class="flex flex-col">
          {
            workTimelineItems.map((item) => (
              <div class="timeline-item border-t-2 border-gray-200 pt-5 pb-5 last:pb-0">
                <p class="text-[11px] font-semibold text-gray-500 mb-1 uppercase tracking-widest" data-i18n={`timeline.${item.i18nKey}.year`}>
                  {item.year}
                </p>
                <h4 class="font-bold text-[15px] leading-snug mb-1 font-almarai" data-i18n={`timeline.${item.i18nKey}.title`}>
                  {item.title}
                </h4>
                <p class="text-gray-500 text-sm leading-relaxed" data-i18n={`timeline.${item.i18nKey}.desc`}>
                  {item.desc}
                </p>
                {item.note && (
                  <p class="italic text-gray-600 text-xs mt-2" data-i18n={`timeline.${item.i18nKey}.note`}>
                    {item.note}
                  </p>
                )}
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Interests and Hobbies -->
  <section id="interests" class="max-w-6xl mx-auto lg:px-0 px-6 md:pt-desktop-top pt-mobil-top">
    <div class="flex flex-col mb-6">
      <h2
        id="interests-title"
        class="font-garamond italic font-bold text-h3-mobile md:text-h3-desktop text-gray-800 mb-6"
        data-i18n="interests.title"
      >
        Interests and hobbies
      </h2>
    </div>
    <div id="interests-and-hobbies" class="grid lg:grid-cols-3 md:grid-cols-2 sm:grid-cols-1 gap-x-10 gap-y-8">
      <div class="interest-item border-t-2 border-gray-200 pt-5">
        <h3 class="text-h4-mobile italic font-semibold text-gray-800 mb-2" data-i18n="interest.japanese.title">Japanese culture</h3>
        <p class="text-gray-500 text-sm leading-relaxed" data-i18n="interest.japanese.text">
          I love the balance between simplicity, detail, and thoughtful storytelling.
        </p>
      </div>
      <div class="interest-item border-t-2 border-gray-200 pt-5">
        <h3 class="text-h4-mobile italic font-semibold text-gray-800 mb-2" data-i18n="interest.lego.title">Building with LEGO</h3>
        <p class="text-gray-500 text-sm leading-relaxed" data-i18n="interest.lego.text">My creative outlet that doesn't require a screen.</p>
      </div>
      <div class="interest-item border-t-2 border-gray-200 pt-5">
        <h3 class="text-h4-mobile italic font-semibold text-gray-800 mb-2" data-i18n="interest.themepark.title">Theme parks &amp; attractions</h3>
        <p class="text-gray-500 text-sm leading-relaxed" data-i18n="interest.themepark.text">
          Something that somehow became a real passion. I love keeping up with the world of theme parks, their attractions, and the stories behind
          them.
        </p>
      </div>
    </div>
  </section>

  <!-- Divider -->
  <div id="about-divider-2" class="max-w-6xl mx-auto lg:px-0 px-6 md:pt-20 pt-14 flex items-center gap-3 text-gray-300" aria-hidden="true">
    <span class="h-px flex-1 bg-gradient-to-r from-transparent via-current to-transparent opacity-70"></span>
    <span class="divider-center block h-2 w-2 rotate-45 border border-current/70 bg-white"></span>
    <span class="h-px flex-1 bg-gradient-to-r from-transparent via-current to-transparent opacity-70"></span>
  </div>

  <!-- Resources Section -->
  <section id="resources" class="resources-section max-w-6xl mx-auto lg:px-0 px-6 md:pt-desktop-top pt-mobil-top">
    <h2
      id="resources-title"
      class="font-garamond font-semibold italic text-h3-mobile md:text-h3-desktop text-gray-800 mb-6"
      data-i18n="resources.title"
    >
      Resources
    </h2>
    <div id="resources-section" class="divide-y divide-gray-200">
      <div class="resource-row flex md:flex-row flex-col md:items-center md:justify-between gap-3 md:gap-0 md:py-5 py-6">
        <h3 class="md:text-h4-desktop text-h4-mobile font-light text-gray-800" data-i18n="resource.resume.en.title">Resume (EN)</h3>
        <span class="self-start">
          <Button
            href="/pdfs/CV_sararpetersen_(EN).pdf"
            target="_blank"
            rel="noopener noreferrer"
            variant="secondary"
            size="small"
            aria-label="See resume (EN, opens in new tab)"
            data-i18n-aria="resource.resume.en.aria"><span data-i18n="resource.resume.en.btn">View resume</span></Button
          >
        </span>
      </div>
      <div class="resource-row flex md:flex-row flex-col md:items-center md:justify-between gap-3 md:gap-0 md:py-5 py-6">
        <h3 class="md:text-h4-desktop text-h4-mobile font-light text-gray-800" data-i18n="resource.cv.da.title">CV (DA)</h3>
        <span class="self-start">
          <Button
            href="/pdfs/CV_sararpetersen_(DA).pdf"
            target="_blank"
            rel="noopener noreferrer"
            variant="secondary"
            size="small"
            aria-label="See CV (DA, opens in new tab)"
            data-i18n-aria="resource.cv.da.aria"><span data-i18n="resource.cv.da.btn">Se CV</span></Button
          >
        </span>
      </div>
    </div>
  </section>

  <!-- Navigation Back to Portfolio -->
  <section class="button-container mx-auto py-20 text-center">
    <Button href="/" variant="primary" size="small"><span data-i18n="btn.back">Back to homepage</span></Button>
  </section>
</MainLayout>

<!-- Accordion script -->
<script>
  document.addEventListener("DOMContentLoaded", () => {
    document.querySelectorAll<HTMLButtonElement>(".accordion-trigger").forEach((trigger) => {
      const panelId = trigger.getAttribute("aria-controls");
      if (!panelId) return;
      const panel = document.getElementById(panelId);
      if (!panel) return;

      trigger.addEventListener("click", () => {
        const isExpanded = trigger.getAttribute("aria-expanded") === "true";
        trigger.setAttribute("aria-expanded", String(!isExpanded));
        panel.classList.toggle("open", !isExpanded);
      });
    });
  });
</script>

<!-- CSS -->
<style>
  /* Accordion tiles */
  .acc-item {
    border: 1px solid #d8d2cc;
    border-radius: 1.5rem;
    background: linear-gradient(to bottom right, #f5f5f5, #f0ebe6);
    transition:
      background-color 0.3s ease,
      border-color 0.3s ease;
  }

  .acc-item:has(.accordion-trigger[aria-expanded="true"]) {
    border-color: #c0d7e1;
    background: #deebef;
  }

  .acc-heading {
    margin: 0;
  }

  .accordion-trigger {
    display: flex;
    align-items: center;
    gap: 1rem;
    width: 100%;
    padding: 1.25rem 1.5rem;
    border: none;
    border-radius: 1.5rem;
    background: none;
    color: inherit;
    text-align: left;
    cursor: pointer;
  }

  .accordion-trigger:focus-visible {
    outline: 3px solid #375567;
    outline-offset: 2px;
  }

  .acc-num {
    flex-shrink: 0;
    border-radius: 9999px;
    background: #deebef;
    color: #2f3f4c;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    padding: 0.35rem 0.7rem;
  }

  .accordion-trigger[aria-expanded="true"] .acc-num {
    background: #375567;
    color: #f5f5f5;
  }

  .acc-title {
    flex: 1;
    font-family: var(--font-garamond);
    font-style: italic;
    font-weight: 600;
    font-size: 1.5rem;
    line-height: 1.2;
    color: #1a1a1a;
  }

  @media (min-width: 768px) {
    .acc-title {
      font-size: 1.85rem;
    }
  }

  .acc-chevron {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid #8f8882;
    border-radius: 9999px;
    color: #375567;
  }

  .accordion-chevron {
    transition: transform 0.3s ease;
  }

  .accordion-trigger[aria-expanded="true"] .accordion-chevron {
    transform: rotate(180deg);
  }

  .accordion-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.35s ease;
    overflow: hidden;
  }

  .accordion-panel.open {
    grid-template-rows: 1fr;
  }

  .accordion-panel > div {
    overflow: hidden;
  }

  .acc-text {
    max-width: 70ch;
    padding: 0 1.5rem 1.5rem;
    font-size: 1.0625rem;
    line-height: 1.75;
    color: #2e2e2e;
  }

  @media (min-width: 768px) {
    .acc-text {
      padding: 0 1.5rem 1.75rem 4.6rem;
    }
  }

  /* Portrait */
  .about-portrait-frame {
    width: min(100%, 24rem);
  }

  .about-portrait-img {
    display: block;
    width: 100%;
    aspect-ratio: 400 / 450;
    object-fit: cover;
    object-position: center 25%;
    border-radius: 1.2rem;
  }

  body.dark .acc-item {
    border-color: var(--dark-border);
    background: linear-gradient(to bottom right, var(--dark-gradient-start), var(--dark-gradient-end));
  }

  body.dark .acc-item:has(.accordion-trigger[aria-expanded="true"]) {
    border-color: rgba(192, 215, 225, 0.35);
    background: linear-gradient(to bottom right, rgba(192, 215, 225, 0.16), rgba(192, 215, 225, 0.07));
  }

  body.dark .acc-item .acc-title {
    color: var(--text-on-dark);
  }

  body.dark .acc-item .acc-text {
    color: var(--text-on-dark-soft);
  }

  body.dark .acc-item .acc-num {
    background: rgba(192, 215, 225, 0.18);
    color: var(--text-on-dark);
  }

  body.dark .acc-item .accordion-trigger[aria-expanded="true"] .acc-num {
    background: #f5f5f5;
    color: #1a1a1a;
  }

  body.dark .acc-item .acc-chevron {
    border-color: var(--dark-border-strong);
    color: var(--brand-primary-soft);
  }

  body.dark .accordion-trigger:focus-visible {
    outline-color: var(--brand-primary-soft);
  }

  /* Pre-animation: hide elements until JS fires */
  html.has-js body:not(.reduce-motion) #about-title-row,
  html.has-js body:not(.reduce-motion) .heading-text,
  html.has-js body:not(.reduce-motion) #about-portrait,
  html.has-js body:not(.reduce-motion) #about-divider-1,
  html.has-js body:not(.reduce-motion) #about-divider-2,
  html.has-js body:not(.reduce-motion) #timeline-title,
  html.has-js body:not(.reduce-motion) .timeline-column-label,
  html.has-js body:not(.reduce-motion) .timeline-item,
  html.has-js body:not(.reduce-motion) .personal-bg-item,
  html.has-js body:not(.reduce-motion) #interests-title,
  html.has-js body:not(.reduce-motion) #interests-and-hobbies > div,
  html.has-js body:not(.reduce-motion) #resources-title,
  html.has-js body:not(.reduce-motion) #resources-section > div,
  html.has-js body:not(.reduce-motion) .button-container {
    opacity: 0;
    transform: translate3d(0, 1.25rem, 0);
    will-change: transform, opacity;
  }

  /* Dark mode */
  body.dark .heading-title,
  body.dark h3,
  body.dark li,
  body.dark a {
    color: var(--text-on-dark);
  }

  body.dark .heading-text {
    color: var(--text-on-dark-soft);
  }

  body.dark .interest-item {
    border-color: var(--dark-border);
  }

  body.dark .interest-item p {
    color: var(--text-on-dark-soft);
  }

  body.dark #resources-section {
    --tw-divide-opacity: 1;
    border-color: var(--dark-border);
  }

  body.dark .resource-row {
    border-color: var(--dark-border);
  }

  body.dark .timeline-item {
    border-color: var(--dark-border);
  }

  body.dark .timeline-item h4 {
    color: var(--text-on-dark);
