---
import Button from "../components/Button.astro";
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout
  title="Contact Sara | SRP Portfolio"
  description="Contact Sara Ringkow Petersen about UX/UI design, digital accessibility and inclusive web design in Denmark."
  ogtitle="Work with Sara – SRP Portfolio"
  ogdescription="Get in touch about UX/UI design, digital accessibility and inclusive web design."
>
  <!-- Contact intro: text and details on the left, portrait on the right -->
  <section id="contact" class="container max-w-6xl mx-auto xl:px-0 px-6 md:pt-desktop-top pt-mobil-top">
    <div id="contact-container" class="grid lg:grid-cols-[minmax(0,1.2fr)_minmax(0,0.8fr)] grid-cols-1 gap-x-0 lg:gap-x-12 gap-y-10 md:pt-28 pt-24 items-start">
      <div>
        <div id="contact-title-row" class="mb-3">
          <h1
            id="contact-title"
            class="heading-title uppercase tracking-[0.14em] md:tracking-[0.18em] font-nikumaru text-[1.85rem] md:text-h2-desktop [overflow-wrap:anywhere]"
            data-i18n="contact.title"
          >
            Get in touch
          </h1>
        </div>
        <p id="contact-text" class="text-left text-gray-800 mb-8 leading-relaxed max-w-xl" data-i18n="contact.text">
          If you'd like to work together or just have a question, you're welcome to reach out. Use the form or contact me directly using the
          information below.
        </p>

        <ul id="contact-info" class="contact-list">
        <li class="contact-row some1">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="contact-icon" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"></path>
          </svg>
          <div>
            <strong class="contact-row-label" data-i18n="contact.info.email">Email</strong>
            <a
              href="mailto:sara.ringkow@gmail.com"
              aria-label="Send email to 'sara.ringkow@gmail.com'"
              data-i18n-aria="contact.email.aria"
              class="contact-link"
              >sara.ringkow@gmail.com</a
            >
          </div>
        </li>
        <li class="contact-row some1">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="contact-icon" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z"></path>
          </svg>
          <div>
            <strong class="contact-row-label" data-i18n="contact.info.phone">Phone*</strong>
            <a
              href="tel:+4542428807"
              aria-describedby="contact-phone-note"
              aria-label="Call +45 42 42 88 07"
              data-i18n-aria="contact.phone.aria"
              class="contact-link">+45 42 42 88 07</a
            >
          </div>
        </li>
        <li class="contact-row some1">
          <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="contact-icon" aria-hidden="true">
            <path fill-rule="evenodd" d="M12.51 8.796v1.697a3.738 3.738 0 0 1 3.288-1.684c3.455 0 4.202 2.16 4.202 4.97V19.5h-3.2v-5.072c0-1.21-.244-2.766-2.128-2.766-1.827 0-2.139 1.317-2.139 2.676V19.5h-3.19V8.796h3.168ZM7.2 6.106a1.61 1.61 0 0 1-.988 1.483 1.595 1.595 0 0 1-1.743-.348A1.607 1.607 0 0 1 5.6 4.5a1.601 1.601 0 0 1 1.6 1.606Z" clip-rule="evenodd"></path>
            <path d="M7.2 8.809H4V19.5h3.2V8.809Z"></path>
          </svg>
          <div>
            <strong class="contact-row-label" data-i18n="contact.info.linkedin">LinkedIn</strong>
            <a
              href="https://www.linkedin.com/in/sara-ringkow-petersen-49830b264/"
              aria-label="Go to 'linkedin.com/in/sara-ringkow-petersen' (external link)"
              data-i18n-aria="contact.linkedin.aria"
              class="contact-link"
              >linkedin.com/in/sara-ringkow-petersen</a
            >
          </div>
        </li>
        </ul>
        <p
          id="contact-phone-note"
          class="contact-phone-note text-xs text-gray-600 leading-relaxed italic mt-3 max-w-xl"
          data-i18n="contact.phone.note"
        >
          *Phone calls can be difficult for me, so Email or LinkedIn are the fastest ways to reach me.
        </p>

        <p id="contact-services-label" data-i18n="contact.services.label" class="contact-services-label">What I offer</p>
        <ul id="contact-services" class="flex flex-wrap gap-2" aria-label="Services offered" data-i18n-aria="contact.services.aria">
          <li class="contact-chip"><span data-i18n="contact.services.uiux">UX/UI design</span></li>
          <li class="contact-chip"><span data-i18n="contact.services.web">Accessible web design</span></li>
          <li class="contact-chip"><span data-i18n="contact.services.concept">Development of concepts</span></li>
          <li class="contact-chip"><span data-i18n="contact.services.brand">Brand and visual identity</span></li>
        </ul>
      </div>

      <div class="flex justify-center lg:justify-end">
        <img
          src="/images/pfp3.webp"
          alt="School-portrait of Sara (taken during the internship preparations)"
          class="contact-portrait w-full max-w-[340px] lg:max-w-[440px] aspect-square object-cover"
          width="350"
          height="350"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- Contact Form Section -->
  <section id="contact-form-section" class="container max-w-6xl mx-auto xl:px-0 px-6 md:pt-desktop-top pt-mobil-top">
    <div id="contact-form-intro" class="mb-8 max-w-3xl">
      <div id="contact-form-title-row" class="mb-3">
        <h2
          id="contact-form-title"
          class="font-garamond italic font-bold text-h3-mobile md:text-h3-desktop text-gray-800"
          data-i18n="contact.form.title"
        >
          Send me a message
        </h2>
      </div>
      <p id="contact-form-subtitle" class="text-gray-600 mb-4 max-w-xl" data-i18n="contact.form.subtitle">
        I'll get back to you as soon as I can. If you're looking for a collaborator for your next project, feel free to reach out and tell me a bit
        about your idea.
      </p>
    </div>

    <div class="grid lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] grid-cols-1 gap-x-0 lg:gap-x-12 gap-y-10 items-center">
      <div>
        <form
          id="contact-form"
          name="contact"
          method="POST"
          action="/contact/?submitted=true"
          data-netlify="true"
          netlify-honeypot="bot-field"
          novalidate
          class="contact-card p-6 md:p-8"
        >
          <input type="hidden" name="form-name" value="contact" />
          <p class="hidden" aria-hidden="true">
            <label>Don't fill this out if you're human: <input name="bot-field" tabindex="-1" /></label>
          </p>

          <div class="space-y-6">
            <div>
              <label for="form-name" class="block text-sm font-semibold text-gray-800 mb-2">
                <span data-i18n="contact.form.name">Name</span><span aria-hidden="true" class="text-red-500">*</span>
                <span class="sr-only">(required)</span>
              </label>
              <input
                type="text"
                id="form-name"
                name="name"
                autocomplete="name"
                required
                aria-required="true"
                aria-describedby="form-name-error"
                class="bg-[#fafafa] w-full px-4 py-2 border border-gray-400 rounded-[5px] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-300 focus-visible:border-transparent transition duration-300"
                data-i18n-placeholder="contact.form.name.ph"
                placeholder="Your name"
              />
              <p id="form-name-error" class="sr-only text-red-700 text-xs" role="alert" aria-atomic="true"></p>
            </div>

            <div>
              <label for="form-email" class="block text-sm font-semibold text-gray-800 mb-2">
                <span data-i18n="contact.form.email">Email</span><span aria-hidden="true" class="text-red-500">*</span>
                <span class="sr-only">(required)</span>
              </label>
              <input
                type="email"
                id="form-email"
                name="email"
                autocomplete="email"
                required
                aria-required="true"
                aria-describedby="form-email-error"
                class="bg-[#fafafa] w-full px-4 py-2 border border-gray-400 rounded-[5px] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-300 focus-visible:border-transparent transition duration-300"
                data-i18n-placeholder="contact.form.email.ph"
                placeholder="your.email@example.com"
              />
              <p id="form-email-error" class="sr-only text-red-700 text-xs" role="alert" aria-atomic="true"></p>
            </div>

            <div>
              <label for="form-message" class="block text-sm font-semibold text-gray-800 mb-2">
                <span data-i18n="contact.form.message">Message</span><span aria-hidden="true" class="text-red-500">*</span>
                <span class="sr-only">(required)</span>
              </label>
              <textarea
                id="form-message"
                name="message"
                autocomplete="off"
                required
                aria-required="true"
                aria-describedby="form-message-error"
                rows={6}
                class="bg-[#fafafa] w-full px-4 py-2 border border-gray-400 rounded-[5px] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-300 focus-visible:border-transparent transition duration-300"
                data-i18n-placeholder="contact.form.message.ph"
                placeholder="Your message..."></textarea>
              <p id="form-message-error" class="sr-only text-red-700 text-xs" role="alert" aria-atomic="true"></p>
            </div>

            <!-- Fine print: GDPR + what happens next -->
            <div class="space-y-2">
              <p class="text-xs text-gray-600 leading-relaxed" data-i18n="contact.form.gdpr">
                By submitting this form you agree to my <a
                  href="/terms"
                  class="underline underline-offset-2 hover:text-blue-500 transition duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-300 text-xs"
                  >Terms & Privacy Policy</a
                >.
              </p>
              <p class="text-xs text-gray-600 leading-relaxed max-w-md italic" data-i18n="contact.form.next">
                (After you hit send, your message goes straight to my inbox and a confirmation appears right here on the page – I usually reply within
                a couple of days)
              </p>
            </div>

            <div class="flex justify-center md:justify-start">
              <Button variant="secondary" size="small" type="submit"><span data-i18n="contact.form.submit">Send Message</span></Button>
            </div>
          </div>

          <div id="form-status" class="hidden mt-6 rounded-lg p-4 text-sm font-medium" role="status" aria-live="polite"></div>
        </form>
      </div>

      <aside id="contact-form-media" class="hidden lg:block">
        <div class="contact-card overflow-hidden">
          <img
            src="/images/contact_image.webp"
            alt="An everyday picture of Sara, taken during a trip to the ocean"
            class="w-full h-[460px] object-cover"
            width="640"
            height="360"
            loading="lazy"
          />
        </div>
      </aside>
    </div>
  </section>

  <section class="button-container mx-auto py-20 flex justify-center">
    <Button href="/" variant="primary" size="small"><span data-i18n="btn.back">Back to homepage</span></Button>
  </section>

  <script>
    (() => {
      const textarea = document.querySelector("#form-message") as HTMLElement | null;
      const contactForm = document.querySelector("#contact-form") as HTMLElement | null;

      if (textarea && contactForm && window.matchMedia("(min-width: 768px)").matches) {
        const observer = new ResizeObserver(() => {
          const style = getComputedStyle(contactForm);
          const paddingH = parseFloat(style.paddingLeft) + parseFloat(style.paddingRight);
          contactForm.style.minWidth = textarea.offsetWidth + paddingH + "px";
        });
        observer.observe(textarea);
      }

      const statusDiv = document.querySelector("#form-status") as HTMLElement | null;
      if (statusDiv) {
        const params = new URLSearchParams(window.location.search);
        if (params.get("submitted") === "true") {
          statusDiv.className = "block rounded-lg p-4 text-sm font-medium bg-green-50 text-green-800 border border-green-200";
          statusDiv.dataset.i18n = "contact.form.success";
          statusDiv.textContent = localStorage.getItem("lang") === "da"
            ? "Tak! Din besked er sendt. Jeg vender tilbage hurtigst muligt."
            : "Thank you! Your message has been sent. I'll get back to you soon.";
        }
      }

      // The form uses novalidate so error text is our own (bilingual), not the browser's
      // built-in bubble — which always renders in the browser's language, not the site's.
      const errorText = {
        en: { required: "This field is required.", email: "Enter a valid email address." },
        da: { required: "Dette felt er påkrævet.", email: "Indtast en gyldig emailadresse." },
      };
      const getLang = () => (localStorage.getItem("lang") === "da" ? "da" : "en");

      const fields = [
        { input: document.querySelector<HTMLInputElement>("#form-name"), error: document.getElementById("form-name-error") },
        { input: document.querySelector<HTMLInputElement>("#form-email"), error: document.getElementById("form-email-error") },
        { input: document.querySelector<HTMLTextAreaElement>("#form-message"), error: document.getElementById("form-message-error") },
      ];

      function showError(error: HTMLElement, key: "required" | "email") {
        error.dataset.errorKey = key;
        error.textContent = errorText[getLang()][key];
        error.classList.remove("sr-only");
        error.classList.add("mt-1.5");
      }
      function clearError(error: HTMLElement) {
        delete error.dataset.errorKey;
        error.textContent = "";
        error.classList.add("sr-only");
        error.classList.remove("mt-1.5");
      }

      function validateField(input: HTMLInputElement | HTMLTextAreaElement, error: HTMLElement | null): boolean {
        if (!error) return true;
        if (input.validity.valueMissing) {
          input.setAttribute("aria-invalid", "true");
          showError(error, "required");
          return false;
        }
        if (input.validity.typeMismatch) {
          input.setAttribute("aria-invalid", "true");
          showError(error, "email");
          return false;
        }
        input.removeAttribute("aria-invalid");
        clearError(error);
        return true;
      }

      if (contactForm) {
        contactForm.addEventListener("submit", (e: Event) => {
          let firstInvalid: HTMLElement | null = null;
          fields.forEach(({ input, error }) => {
            if (!input) return;
            if (!validateField(input, error) && !firstInvalid) firstInvalid = input;
          });
          if (firstInvalid) {
            e.preventDefault();
            (firstInvalid as HTMLElement).focus();
          }
        });

        // Re-validate on blur so an error clears the moment it's fixed, not only on the next submit.
        fields.forEach(({ input, error }) => {
          input?.addEventListener("blur", () => validateField(input, error));
        });
      }

      // If the language changes while an error is showing, re-render it in the new language.
      window.addEventListener("langchange", () => {
        fields.forEach(({ error }) => {
          const key = error?.dataset.errorKey as "required" | "email" | undefined;
          if (error && key) error.textContent = errorText[getLang()][key];
        });
      });
    })();
  </script>

  <style>
    /* Same family as the About page: thin 1px border, soft gradient, rounded tile */
    :global(.contact-card) {
      border: 1px solid #d8d2cc;
      border-radius: 1.5rem;
      background: linear-gradient(to bottom right, #f5f5f5, #f0ebe6);
    }

    :global(.contact-portrait) {
      border: 1px solid #d8d2cc;
      border-radius: 1.5rem;
    }

    :global(.contact-list) {
      margin: 0;
      padding: 0;
      list-style: none;
      border-bottom: 1px solid #d8d2cc;
      max-width: 36rem;
    }

    :global(.contact-row) {
      display: flex;
      align-items: flex-start;
      gap: 1rem;
      padding: 1rem 0;
      border-top: 1px solid #d8d2cc;
    }

    :global(.contact-icon) {
      flex-shrink: 0;
      width: 1.75rem;
      height: 1.75rem;
      color: #4b4b4b;
    }

    :global(.contact-row-label) {
      display: block;
      margin-bottom: 0.15rem;
      font-size: 0.8rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #1a1a1a;
    }

    :global(.contact-link) {
      display: inline-block;
      padding: 0.15rem 0;
      border-radius: 0.25rem;
      overflow-wrap: anywhere;
      transition: color 0.2s ease;
    }

    :global(.contact-link:focus-visible) {
      outline: 3px solid #375567;
      outline-offset: 2px;
    }

    :global(.contact-link:hover) {
      color: var(--brand-primary);
    }

    :global(.contact-services-label) {
      margin: 1.75rem 0 0.6rem;
      font-size: 0.8rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #5a5149;
    }

    :global(.contact-chip) {
      border-radius: 9999px;
      background: #deebef;
      color: #2f3f4c;
      font-size: 0.8rem;
      font-weight: 600;
      line-height: 1.3;
      padding: 0.4rem 0.9rem;
    }

    :global(#contact-form input::placeholder),
    :global(#contact-form textarea::placeholder) {
      color: #6b645d;
      opacity: 1;
    }

    /* Required-field asterisk: Tailwind red-500 is only 3.5:1 on the form tile */
    :global(#contact-form label .text-red-500) {
      color: #b3222d;
    }

    /* The privacy link sits inside 12px fine print; keep it on the paragraph's line height */
    :global(#contact-form p a) {
      line-height: inherit;
    }

    @media (min-width: 768px) {
      :global(#form-message) {
        resize: both;
      }
    }

    :global(body.dark .contact-card) {
      border-color: var(--dark-border);
      background: linear-gradient(to bottom right, var(--dark-gradient-start), var(--dark-gradient-end));
    }

    :global(body.dark .contact-portrait),
    :global(body.dark .contact-list),
    :global(body.dark .contact-row) {
      border-color: var(--dark-border);
    }

    :global(body.dark .contact-icon) {
      color: var(--text-on-dark-soft);
    }

    :global(body.dark .contact-row-label),
    :global(body.dark #contact-title),
    :global(body.dark #contact-form-section h2),
    :global(body.dark #contact-form-section label) {
      color: var(--text-on-dark);
    }

    :global(body.dark .contact-link) {
      color: var(--text-on-dark-soft);
    }

    :global(body.dark .contact-link:hover) {
      color: var(--brand-primary-soft);
    }

    :global(body.dark .contact-link:focus-visible) {
      outline-color: var(--brand-primary-soft);
    }

    :global(body.dark .contact-services-label),
    :global(body.dark .contact-phone-note),
    :global(body.dark #contact-text),
    :global(body.dark #contact-form-subtitle),
    :global(body.dark #contact-form p:not([role="alert"])) {
      color: var(--text-on-dark-soft);
    }

    :global(body.dark .contact-chip) {
      background: rgba(192, 215, 225, 0.18);
      color: var(--text-on-dark);
    }

    /* text-red-700 (#b3222d) is 2.6:1 on the dark form background; reuse the coral already used for
       the dark-mode focus ring, which clears 4.5:1 here. */
    :global(body.dark #contact-form p[role="alert"]),
    :global(body.dark #contact-form label .text-red-500) {
      color: #ff6f61;
    }

    :global(body.dark #contact-form input),
    :global(body.dark #contact-form textarea) {
      background-color: color-mix(in srgb, var(--dark-surface) 86%, #fff 14%);
      color: var(--text-on-dark);
      border-color: color-mix(in srgb, var(--dark-border) 72%, #dbe8ee 28%);
    }

    :global(body.dark #contact-form input::placeholder),
    :global(body.dark #contact-form textarea::placeholder) {
      color: color-mix(in srgb, var(--text-on-dark-soft) 78%, #8f9aa1 22%);
    }

    :global(body.dark #contact-form input:focus),
    :global(body.dark #contact-form textarea:focus) {
      border-color: color-mix(in srgb, var(--brand-primary-soft) 70%, #fff 30%);
      background-color: color-mix(in srgb, var(--dark-surface-strong) 74%, #fff 26%);
      box-shadow: 0 0 0 3px rgba(149, 188, 203, 0.24);
    }

    :global(body.dark p[data-i18n="contact.form.gdpr"] a) {
      color: var(--brand-primary-soft, #c0d7e1);
    }

    :global(body.dark p[data-i18n="contact.form.gdpr"] a:hover) {
      color: var(--brand-primary-strong, #95bccb);
    }
  </style>
</MainLayout>
