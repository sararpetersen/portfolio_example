---
import MainLayout from "../layouts/MainLayout.astro";
import "../styles/global.css";
import Button from "../components/Button.astro";
import LabProjectCards from "../components/LabProjectCards.astro";
import { labProjects } from "../data/labProjects";
---

<MainLayout
  title="Design Experiments | SRP Portfolio"
  description="Explore accessible design experiments, neurodivergent/disability-inspired UX concepts, prototypes and AI-assisted projects created by Sara Ringkow Petersen."
  ogtitle="Design Experiments & Prototypes – SRP Portfolio"
  ogdescription="Experimental tools and inclusive digital concepts exploring neurodivergence, disability and accessible design."
>
  <!-- Lab Intro -->
  <section id="lab" class="grid grid-cols-12 gap-x-0 gap-y-10 max-w-6xl mx-auto md:pt-desktop-top pt-mobil-top md:mt-16 mt-8 xl:px-0 px-6 relative">
    <div class="col-span-12">
      <div class="lg:pt-12 pt-16 mb-8">
        <div id="lab-title-row" class="mb-3">
          <h1
            class="uppercase tracking-[0.14em] md:tracking-[0.18em] font-nikumaru text-[1.85rem] md:text-h2-desktop [overflow-wrap:anywhere]"
            data-i18n="lab.title"
          >
            Experiments
          </h1>
        </div>
        <p id="lab-intro" class="text-gray-600 max-w-3xl leading-relaxed text-left" data-i18n="lab.intro">
          This is where I put the looser stuff – projects built with help from AI, unfinished prototypes, and things that exist mostly because I
          wanted to see if they could work. Less polished than the main cases, but more honest about the process.
        </p>
      </div>

      <!-- What is vibe coding -->
      <div id="lab-about">
        <div class="lab-tile p-6 md:p-8 max-w-3xl">
          <h2 id="lab-vibe-title" class="font-garamond italic font-semibold text-gray-800 text-xl mb-3" data-i18n="lab.vibe.title">
            What is <em>'vibe coding'</em>?
          </h2>

          <p id="lab-vibe-text" class="text-gray-600 leading-relaxed" data-i18n="lab.vibe.text">
            <em>'Vibe coding'</em> is building with AI assistance. You describe what you want, the AI generates the code, and you shape and guide it. It's
            less about writing every line yourself and more about knowing what you want and being able to evaluate what you get. It changes how you think
            about prototyping and iteration.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Lab Items -->
  <section id="lab-items" class="max-w-6xl mx-auto xl:px-0 px-6 md:pt-desktop-top pt-mobil-top">
    <h2 id="lab-items-title" class="font-garamond font-bold italic md:text-h3-desktop text-h3-mobile text-gray-800 mb-3" data-i18n="lab.items.title">
      Projects from the Lab
    </h2>

    <p id="lab-items-intro" class="text-sm text-gray-600 leading-relaxed max-w-2xl mb-6" data-i18n="lab.items.intro">
      A collection of experimental tools and concepts centred on neurodiversity, disability, and accessible design. Steady is the project I have
      worked on for the longest, growing through repeated accessibility work, user testing, and product iteration.
    </p>

    <p
      class="lab-legend flex flex-col items-start gap-y-4 lg:flex-row lg:flex-wrap lg:items-center lg:gap-x-3 lg:gap-y-1.5 text-[11px] text-gray-600 mb-6"
    >
      <span class="inline-flex flex-col items-start gap-1.5 lg:flex-row lg:items-center">
        <span
          class="lab-tag long-running-tag"
          tabindex="0"
          role="note"
          aria-label="Longest-running project"
          data-i18n-aria="lab.badge.longrunning"
          data-tooltip="The Lab project I have developed over the longest period"
          data-i18n-tooltip="lab.badge.longrunning.tooltip"
          ><span data-i18n="lab.badge.longrunning">Longest-running project</span></span
        >
        <span data-i18n="lab.legend.longrunning">= developed over the longest period</span>
      </span>
      <span class="text-gray-500 hidden lg:inline" aria-hidden="true">·</span>
      <span class="inline-flex flex-col items-start gap-1.5 lg:flex-row lg:items-center">
        <span
          class="lab-tag"
          tabindex="0"
          role="note"
          aria-label="Vibe coded"
          data-i18n-aria="lab.badge.vibecoded"
          data-tooltip="This project was built with AI assistance"
          data-i18n-tooltip="lab.badge.vibecoded.tooltip"><span data-i18n="lab.badge.vibecoded">Vibe coded</span></span
        >
        <span data-i18n="lab.legend.vibecoded">= built with AI assistance</span>
      </span>
    </p>

    <!-- Project cards keep their existing layout, but are generated from one data source. -->
    <LabProjectCards projects={labProjects} />
  </section>

  <!-- Back to homepage -->
  <section class="lab-back-btn mx-auto py-20 text-center">
    <Button href="/" variant="primary" size="small"><span data-i18n="btn.back">Back to homepage</span></Button>
  </section>
</MainLayout>

<style>
  html.has-js body:not(.reduce-motion) #lab-label,
  html.has-js body:not(.reduce-motion) #lab-title-row,
  html.has-js body:not(.reduce-motion) #lab-intro,
  html.has-js body:not(.reduce-motion) #lab-about,
  html.has-js body:not(.reduce-motion) #lab-items-title,
  html.has-js body:not(.reduce-motion) #lab-items-intro,
  html.has-js body:not(.reduce-motion) #lab-item-bivi,
  html.has-js body:not(.reduce-motion) #lab-item-autismeguiden,
  html.has-js body:not(.reduce-motion) #lab-item-steady,
  html.has-js body:not(.reduce-motion) #lab-items > div > article,
  html.has-js body:not(.reduce-motion) #lab-items > div > div,
  html.has-js body:not(.reduce-motion) .lab-legend > span {
    opacity: 0;
    transform: translate3d(0, 1.25rem, 0);
    will-change: transform, opacity;
  }

  /* Same thin-border tile as the About, Contact and Blog pages */
  .lab-tile {
    border: 1px solid #d8d2cc;
    border-radius: 1.5rem;
    background: linear-gradient(to bottom right, #f5f5f5, #f0ebe6);
  }

  /* Badges: one quiet pale chip style; the label text, not the colour, says which is which */
  .lab-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    max-width: 100%;
    border-radius: 9999px;
    background: #deebef;
    color: #2f3f4c;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1;
    padding: 0.5rem 1.1rem;
    text-transform: uppercase;
  }

  .lab-tag:focus-visible {
    outline: 3px solid #375567;
    outline-offset: 2px;
  }

  .long-running-tag {
    background: #375567;
    color: #f5f5f5;
  }

  /* Dark mode — text */
  body.dark #lab-label,
  body.dark #lab-intro,
  body.dark #lab-vibe-text,
  body.dark #lab-items-intro {
    color: var(--text-on-dark-soft);
  }

  body.dark #lab h1,
  body.dark #lab-vibe-title,
  body.dark #lab-items-title {
    color: var(--text-on-dark);
  }

  /* Dark mode — card backgrounds */
  body.dark .lab-tile {
    border-color: var(--dark-border);
    background: linear-gradient(to bottom right, var(--dark-gradient-start), var(--dark-gradient-end));
  }

  /* Dark mode — badges */
  body.dark .lab-tag {
    background: rgba(192, 215, 225, 0.18);
    color: var(--text-on-dark);
  }

  body.dark .long-running-tag {
    background: #f5f5f5;
    color: #1a1a1a;
  }

  body.dark .lab-legend {
    color: var(--text-on-dark-soft);
  }
</style>
