---
import MainLayout from "../layouts/MainLayout.astro";
import "../styles/global.css";
import Button from "../components/Button.astro";
import LabProjectCards from "../components/LabProjectCards.astro";
import { labProjects } from "../data/labProjects";
---

<MainLayout
  title="Design Experiments | SRP Portfolio"
  description="Explore accessible design experiments, neurodivergent/disability-inspired UX concepts, prototypes and AI-assisted projects created by Sara Ringkow Petersen."
  ogtitle="Design Experiments & Prototypes – SRP Portfolio"
  ogdescription="Experimental tools and inclusive digital concepts exploring neurodivergence, disability and accessible design."
>
  <!-- Lab Intro -->
  <section id="lab" class="grid grid-cols-12 gap-x-0 gap-y-10 max-w-6xl mx-auto md:pt-desktop-top pt-mobil-top md:mt-16 mt-8 xl:px-0 px-6 relative">
    <div class="col-span-12">
      <div class="lg:pt-12 pt-16">
        <div id="lab-title-row" class="mb-3">
          <h1
            class="uppercase tracking-[0.14em] md:tracking-[0.18em] font-nikumaru text-[1.85rem] md:text-h2-desktop [overflow-wrap:anywhere]"
            data-i18n="lab.title"
          >
            Experiments
          </h1>
        </div>
        <p id="lab-intro" class="text-gray-600 max-w-3xl leading-relaxed text-left" data-i18n="lab.intro">
          These are the things I build with AI. I describe an idea, the AI writes the code, and I do the steering – testing it, breaking it, fixing
          it. They're rougher than my main cases, but I'd rather show you the real process than hide it.{" "}<a href="/blog/vibe-coding"
            >Here's what I think about vibe coding.</a
          >
        </p>
      </div>
    </div>
  </section>

  <!-- Lab Items -->
  <section id="lab-items" class="max-w-6xl mx-auto xl:px-0 px-6 md:pt-12 pt-8">
    <h2 id="lab-items-title" class="sr-only" data-i18n="lab.items.title">Projects from the Lab</h2>

    <!-- Project cards keep their existing layout, but are generated from one data source. -->
    <LabProjectCards projects={labProjects} />
  </section>

  <!-- Back to homepage -->
  <section class="lab-back-btn mx-auto py-20 text-center">
    <Button href="/" variant="primary" size="small"><span data-i18n="btn.back">Back to homepage</span></Button>
  </section>
</MainLayout>

<style>
  html.has-js body:not(.reduce-motion) #lab-label,
  html.has-js body:not(.reduce-motion) #lab-title-row,
  html.has-js body:not(.reduce-motion) #lab-intro,
  html.has-js body:not(.reduce-motion) #lab-items-title,
  html.has-js body:not(.reduce-motion) #lab-items-intro,
  html.has-js body:not(.reduce-motion) #lab-item-bivi,
  html.has-js body:not(.reduce-motion) #lab-item-autismeguiden,
  html.has-js body:not(.reduce-motion) #lab-item-steady,
  html.has-js body:not(.reduce-motion) #lab-items > div > article,
  html.has-js body:not(.reduce-motion) #lab-items > div > div,
  html.has-js body:not(.reduce-motion) .lab-legend > span {
    opacity: 0;
    transform: translate3d(0, 1.25rem, 0);
    will-change: transform, opacity;
  }

  /* Link to the vibe coding post at the end of the intro. The intro text is swapped in by the language
     switcher, so these rules cannot rely on Astro's scoped attributes. */
  :global(#lab-intro a) {
    /* The base link style sets its own, larger font size; follow the small paragraph around it instead */
    font-size: inherit;
    line-height: inherit;
    color: #375567;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  :global(#lab-intro a:hover) {
    color: var(--brand-primary);
  }

  :global(#lab-intro a:focus-visible) {
    outline: 3px solid #375567;
    outline-offset: 2px;
    border-radius: 2px;
  }

  :global(body.dark #lab-intro a) {
    color: var(--brand-primary-soft);
  }

  /* Dark mode — text */
  body.dark #lab-label,
  body.dark #lab-intro,
  body.dark #lab-items-intro {
    color: var(--text-on-dark-soft);
  }

  body.dark #lab h1,
  body.dark #lab-items-title {
    color: var(--text-on-dark);
  }

  /* Dark mode — card backgrounds */

  body.dark .lab-legend {
    color: var(--text-on-dark-soft);
  }
</style>
