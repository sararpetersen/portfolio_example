---
import MainLayout from "../layouts/MainLayout.astro";
import CaseStudy from "../components/CaseStudy.astro";
import { getCaseStudy } from "../data/caseStudies";

const caseStudy = getCaseStudy("steady");
if (!caseStudy) throw new Error("Steady case study data is missing");

const schema = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  name: "Steady: Inclusive Design Case Study",
  author: { "@type": "Person", name: "Sara Ringkow Petersen" },
  dateCreated: "2026",
  dateModified: "2026-08-23",
  description: caseStudy.summary.en,
  url: "https://sararingkow.dk/steady",
};
---

<MainLayout
  title="Steady Inclusive Design Case Study | SRP Portfolio"
  description="See how Steady turned neurodivergent UX principles, mobile user testing and adoption data into a calmer daily-planning experience."
  ogtitle="Steady: An Inclusive Design Case Study"
  ogdescription="From neurodivergent UX principles to real mobile testing, feedback-led iteration and early adoption evidence."
  schema={schema}
>
  <CaseStudy caseStudy={caseStudy} />
</MainLayout>
