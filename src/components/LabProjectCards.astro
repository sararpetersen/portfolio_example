---
import Button from "./Button.astro";
import type { LabProject } from "../data/labProjects";

const { projects } = Astro.props as { projects: LabProject[] };
---

<div class="grid md:grid-cols-2 gap-6">
  {
    projects.map((project) => {
      const isExternal = project.href.startsWith("http");
      const baseCardClass = project.featured
        ? "lab-featured-card lab-tile md:col-span-2 p-6 md:p-8"
        : "lab-tile p-6 md:p-8";
      const cardClass = `${baseCardClass}${project.longRunning ? " lab-long-running-card" : ""}`;

      return (
        <article id={`lab-item-${project.slug}`} class={cardClass}>
          <div class="flex flex-col items-start gap-3 md:flex-row md:items-center md:justify-between mb-4">
            <p class="text-[12px] uppercase tracking-[0.2em] text-gray-500 whitespace-nowrap shrink-0">{project.year}</p>
            <div class="flex items-center gap-2 flex-wrap md:justify-end">
              {project.longRunning && (
                <span
                  class="lab-tag pill pill-ink long-running-tag"
                  tabindex="0"
                  role="note"
                  aria-label="Longest-running project"
                  data-i18n-aria="lab.badge.longrunning"
                  data-tooltip="The Lab project I have developed over the longest period"
                  data-i18n-tooltip="lab.badge.longrunning.tooltip"
                >
                  <span data-i18n="lab.badge.longrunning">Longest-running project</span>
                </span>
              )}
              <span
                class="lab-tag pill"
                tabindex="0"
                role="note"
                aria-label="Vibe coded"
                data-i18n-aria="lab.badge.vibecoded"
                data-tooltip="This project was built with AI assistance"
                data-i18n-tooltip="lab.badge.vibecoded.tooltip"
              >
                <span data-i18n="lab.badge.vibecoded">Vibe coded</span>
              </span>
              {project.wip && (
                <span
                  class="lab-tag pill wip-tag"
                  tabindex="0"
                  role="note"
                  aria-label="WIP"
                  data-tooltip="Work in progress – the coded version is still being developed"
                  data-i18n-tooltip="lab.badge.wip.tooltip"
                >
                  WIP
                </span>
              )}
            </div>
          </div>

          <div class={project.featured ? "max-w-3xl" : undefined}>
            <h3
              class:list={["italic font-bold text-h4-mobile md:text-[1.3rem] leading-snug mb-5 text-gray-800", project.longRunning ? "mb-3" : "mb-6"]}
            >
              <span data-i18n={project.titleKey}>{project.titleFallback}</span>
            </h3>
            <Button
              href={project.href}
              target={isExternal ? "_blank" : undefined}
              rel={isExternal ? "noopener noreferrer" : undefined}
              variant="secondary"
              size="small"
              aria-label={project.ariaLabel}
              data-i18n-aria={project.ariaLabelKey}
            >
              <span data-i18n={project.linkKey}>{project.linkFallback}</span>
            </Button>
          </div>
        </article>
      );
    })
  }
</div>

<style>
  :global(html.has-js body:not(.reduce-motion)) article {
    opacity: 0;
    transform: translate3d(0, 1.25rem, 0);
    will-change: transform, opacity;
  }

  :global(.lab-tile) {
    border: 1px solid #d8d2cc;
    border-radius: 1.5rem;
    background: linear-gradient(to bottom right, #f5f5f5, #f0ebe6);
  }

  .lab-tag:focus-visible {
    outline: 3px solid #375567;
    outline-offset: 2px;
  }

  :global(body.dark) article {
    border-color: var(--dark-border);
    background: linear-gradient(to bottom right, var(--dark-gradient-start), var(--dark-gradient-end));
  }

  :global(body.dark) article p {
    color: var(--text-on-dark-soft);
  }

  :global(body.dark) article h3 {
    color: var(--text-on-dark);
  }

</style>
