---
import type { CaseStudy } from "../data/caseStudies";
import Button from "./Button.astro";

const { caseStudy } = Astro.props as { caseStudy: CaseStudy };

const statusLabels = {
  documented: { en: "Observed in the product", da: "Observeret i produktet" },
  reflection: { en: "Design reflection", da: "Designrefleksion" },
  pending: { en: "Documentation needed", da: "Kræver dokumentation" },
};
---

<div class="case-study max-w-6xl mx-auto px-6 xl:px-0 mt-20 md:pt-desktop-top pt-mobil-top pb-mobil-bottom md:pb-desktop-bottom">
  <nav aria-label="Breadcrumb" data-i18n-aria="nav.breadcrumb.aria" class="mb-10 text-sm text-gray-500">
    <a
      href="/lab"
      class="case-back-link hover:text-blue-500 underline hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-300"
    >
      <span class="case-en">←&nbsp;Back to the Lab</span><span class="case-da">←&nbsp;Tilbage til Laboratoriet</span>
    </a>
  </nav>

  <header class="case-hero">
    <p class="mb-4"><span class="pill">{caseStudy.year} · UX/UI case study</span></p>
    <div class="flex items-center gap-4 mb-1">
      {caseStudy.logo && <img src={caseStudy.logo} alt="" width="48" height="48" class="shrink-0" />}
      <h1 class="font-nikumaru not-italic uppercase tracking-[0.14em] text-h3-mobile md:text-h2-desktop [overflow-wrap:anywhere] min-w-0">
        {caseStudy.name}
      </h1>
    </div>
    <p class="font-garamond italic text-h4-mobile text-gray-700 mb-6">
      <span class="case-en">{caseStudy.tagline.en}</span><span class="case-da">{caseStudy.tagline.da}</span>
    </p>
    <p class="text-gray-600 max-w-3xl leading-relaxed">
      <span class="case-en">{caseStudy.summary.en}</span><span class="case-da">{caseStudy.summary.da}</span>
    </p>

    <dl class="grid md:grid-cols-2 gap-5 mt-9 pt-7 border-t border-[#a8a098]">
      <div>
        <dt class="case-dt text-xs uppercase tracking-widest font-bold mb-1">
          <span class="case-en">Role</span><span class="case-da">Rolle</span>
        </dt>
        <dd class="text-gray-700"><span class="case-en">{caseStudy.role.en}</span><span class="case-da">{caseStudy.role.da}</span></dd>
      </div>
      <div>
        <dt class="case-dt text-xs uppercase tracking-widest font-bold mb-1">
          <span class="case-en">Audience</span><span class="case-da">Målgruppe</span>
        </dt>
        <dd class="text-gray-700"><span class="case-en">{caseStudy.audience.en}</span><span class="case-da">{caseStudy.audience.da}</span></dd>
      </div>
    </dl>
  </header>

  <aside aria-labelledby="case-navigation-title" class="case-nav my-10 pt-6 border-t border-[#a8a098]">
    <h2 id="case-navigation-title" class="font-garamond italic font-bold text-h4-mobile md:text-h4-desktop text-gray-800 mb-3">
      <span class="case-en">In this case</span><span class="case-da">I denne case</span>
    </h2>
    <ol class="grid md:grid-cols-2 gap-x-8 gap-y-2 list-decimal list-inside">
      {
        caseStudy.sections.map((section) => (
          <li>
            <a
              href={`#${section.id}`}
              class="case-nav-link text-blue-600 underline hover:text-blue-500 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-300"
            >
              <>
                <span class="case-en" set:html={section.title.en} />
                <span class="case-da" set:html={section.title.da} />
              </>
            </a>
          </li>
        ))
      }
    </ol>
  </aside>

  <div class="space-y-8">
    {
      caseStudy.sections.map((section) => (
        <section id={section.id} class="case-section grid md:grid-cols-12 gap-5 border-b border-[#d8d2cc] pb-10">
          <div class="md:col-span-4">
            <p class="case-step text-xs uppercase tracking-[0.18em] text-blue-700 font-bold mb-3">
              <>
                <span class="case-en">{section.eyebrow.en}</span>
                <span class="case-da">{section.eyebrow.da}</span>
              </>
            </p>
            {section.status && (
              <span class={`case-status pill case-status--${section.status}`}>
                <span class="case-en">{statusLabels[section.status].en}</span>
                <span class="case-da">{statusLabels[section.status].da}</span>
              </span>
            )}
          </div>
          <div class="md:col-span-8">
            <h2 class="font-garamond italic font-semibold text-h4-mobile md:text-h4-desktop text-gray-800 mb-1">
              <>
                <span class="case-en" set:html={section.title.en} />
                <span class="case-da" set:html={section.title.da} />
              </>
            </h2>
            <p class="text-gray-600 leading-relaxed">
              <>
                <span class="case-en" set:html={section.body.en} />
                <span class="case-da" set:html={section.body.da} />
              </>
            </p>
            {section.points && (
              <ul class="mt-6 space-y-2 text-gray-600 list-disc pl-5">
                {section.points.map((point) => (
                  <li>
                    <span class="case-en" set:html={point.en} />
                    <span class="case-da" set:html={point.da} />
                  </li>
                ))}
              </ul>
            )}
          </div>
        </section>
      ))
    }
  </div>

  <section aria-labelledby="case-links-title" class="case-tile mt-12 p-6 md:p-10">
    <h2 id="case-links-title" class="font-garamond font-bold italic text-2xl text-gray-800 mb-3">
      <span class="case-en">Try Steady</span><span class="case-da">Prøv Steady</span>
    </h2>
    <p class="text-gray-600 mb-6">
      <span class="case-en">See the public product, and try it out for yourself.</span><span class="case-da"
        >Se det offentlige produkt og prøv det for dig selv.</span
      >
    </p>
    <div class="flex flex-wrap gap-4">
      {
        caseStudy.links.map((link) => (
          <Button
            href={link.url}
            target={link.external === false ? undefined : "_blank"}
            rel={link.external === false ? undefined : "noopener noreferrer"}
            variant="secondary"
            size="small"
            aria-label={link.external === false ? link.label.en : `${link.label.en} (opens in new tab)`}
            data-aria-en={link.external === false ? link.label.en : `${link.label.en} (opens in new tab)`}
            data-aria-da={link.external === false ? link.label.da : `${link.label.da} (åbner i en ny fane)`}
          >
            <>
              <span class="case-en">{link.label.en}&nbsp;→</span>
              <span class="case-da">{link.label.da}&nbsp;→</span>
            </>
          </Button>
        ))
      }
    </div>
  </section>
</div>

<style>
  .case-da {
    display: none;
  }
  :global(html[lang="da"]) .case-en {
    display: none;
  }
  :global(html[lang="da"]) .case-da {
    display: inline;
  }
  /* Same thin-border tile as the About, Contact, Blog and Lab pages */
  .case-tile {
    border: 1px solid #d8d2cc;
    border-radius: 1.5rem;
    background: linear-gradient(to bottom right, #f5f5f5, #f0ebe6);
  }

  .case-dt {
    color: #375567;
  }

  /* Calm mode lightens the heading grey to 4.4:1 on the page; keep headings readable */
  :global(body.calm-mode:not(.dark)) .case-study h2 {
    color: #262626;
  }

  :global(body.dark) .case-study h1,
  :global(body.dark) .case-study h2,
  :global(body.dark) .case-study dt,
  :global(body.dark) .case-study span p {
    color: var(--text-on-dark);
  }

  :global(body.dark) .case-study dd,
  :global(body.dark) .case-study p,
  :global(body.dark) .case-study li {
    color: var(--text-on-dark-soft);
  }

  :global(body.dark) .case-study .case-step {
    color: var(--text-on-dark);
  }

  /* Rich text from set:html does not receive Astro scoped attributes. */
  :global(body.dark .case-section a) {
    color: var(--brand-primary-soft);
  }

  :global(body.dark .case-section a:hover) {
    color: var(--brand-primary-strong);
  }

  :global(body.dark .case-study li strong) {
    color: var(--text-on-dark);
  }

  :global(body.dark) .case-study .case-tile {
    background: linear-gradient(to bottom right, var(--dark-gradient-start), var(--dark-gradient-end));
    border-color: var(--dark-border);
  }
  :global(body.dark) .case-study .case-section {
    border-color: var(--dark-border);
  }
  :global(body.dark) .case-study .case-nav,
  :global(body.dark) .case-study dl {
    border-color: rgba(255, 255, 255, 0.28);
  }
  :global(body.dark) .case-study .case-dt {
    color: var(--brand-primary-soft, #c0d7e1);
  }
  :global(body.dark) .case-study .case-nav-link {
    color: var(--brand-primary-soft);
  }
  :global(body.dark) .case-study .case-nav-link:hover {
    color: var(--brand-primary-strong);
  }
  :global(body.dark) .case-study .case-back-link {
    color: var(--text-on-dark-soft);
  }
  :global(body.dark) .case-study .case-back-link:hover {
    color: var(--brand-primary-soft);
  }
</style>
