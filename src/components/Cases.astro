---
import { fetchPortfolioCases, NON_ACTIVE_CASE_SLUGS, type PortfolioCase } from "../data/portfolioCases";

type ProjectCard = Partial<PortfolioCase> & Pick<PortfolioCase, "image">;

const { projects: propProjects } = Astro.props;

const getDegreeLabel = (period?: string) => {
  if (!period) return "";

  const parts = period
    .split("·")
    .map((part) => part.trim())
    .filter(Boolean);

  return parts[parts.length - 1] || "";
};

const projects = (propProjects ?? (await fetchPortfolioCases())) as ProjectCard[];

// Bento layout on a 6-column desktop grid: rows of [4,2], [2,4], [3,3]. A row that isn't full
// (fewer cases than the pattern) shares the 6 columns evenly, so there is never a gap.
const lgSpanClass: Record<number, string> = { 2: "lg:col-span-2", 3: "lg:col-span-3", 4: "lg:col-span-4", 6: "lg:col-span-6" };
const rowPattern = [
  [4, 2],
  [2, 4],
  [3, 3],
];
const lgSpans: number[] = [];
let remaining = projects.length;
for (let row = 0; remaining > 0; row++) {
  const pattern = rowPattern[row % rowPattern.length];
  if (remaining >= pattern.length) {
    lgSpans.push(...pattern);
    remaining -= pattern.length;
  } else {
    lgSpans.push(...Array(remaining).fill(6 / remaining));
    remaining = 0;
  }
}

const MAX_CHIPS = 3;
---

<div class="carousel w-full col-span-12">
  <ul id="project-cards" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-5">
    {
      projects.map((project: ProjectCard, index: number) => {
        const isInactive = NON_ACTIVE_CASE_SLUGS.has(project.slug || "");
        const isFeatured = index === 0;
        const isLastOddOnTablet = index === projects.length - 1 && (projects.length - 1) % 2 === 1;
        const tabletSpan = isFeatured || isLastOddOnTablet ? "md:col-span-2" : "";
        const tools = project.tools ?? [];
        const Tag = isInactive ? "div" : "a";

        return (
          <li
            class:list={["case-tile group", lgSpanClass[lgSpans[index]] ?? "lg:col-span-2", tabletSpan]}
            data-id={project.id ?? ""}
            data-name={project.name ? project.name.toLowerCase() : ""}
            data-inactive={isInactive ? "true" : "false"}
          >
            <Tag href={isInactive ? undefined : `/${project.slug}`} class="case-tile-inner">
              <div class="case-tile-media">
                <img src={project.image} alt="" class="case-tile-img" loading={index < 2 ? "eager" : "lazy"} width="800" height="600" />
              </div>
              <div class="case-tile-body">
                <div class="case-tile-meta">
                  <span class="case-tile-degree" data-year={project.year || ""} data-year-da={project.year_da || ""}>
                    {getDegreeLabel(project.year)}
                  </span>
                  <span
                    class="card-period case-tile-period"
                    data-semester={project.semester || ""}
                    data-semester-da={project.semester_da || ""}
                    data-year={project.year || ""}
                    data-year-da={project.year_da || ""}
                  >
                    {project.semester || project.year}
                  </span>
                </div>
                <h3 class="case-tile-title">{project.name}</h3>
                <div class="case-tile-foot">
                  <ul class="case-tile-chips" aria-label="Tools used" data-i18n-aria="project.tools.aria">
                    {tools.slice(0, MAX_CHIPS).map((tool: string) => (
                      <li class="case-tile-chip">{tool}</li>
                    ))}
                    {tools.length > MAX_CHIPS && <li class="case-tile-chip case-tile-chip-more">+{tools.length - MAX_CHIPS}</li>}
                  </ul>
                  {!isInactive && (
                    <span class="case-tile-arrow" aria-hidden="true">
                      →
                    </span>
                  )}
                </div>
              </div>
            </Tag>
          </li>
        );
      })
    }
  </ul>
</div>

<script>
  const getLang = () => localStorage.getItem("lang") || "en";

  const applyCardTranslations = (lang: string) => {
    const getCurrentPeriod = (el: HTMLElement) => {
      const year = el.dataset.year || "";
      const yearDa = el.dataset.yearDa || "";
      const semester = el.dataset.semester || "";
      const semesterDa = el.dataset.semesterDa || "";

      const currentYear = lang === "da" ? yearDa || year : year;
      const currentSemester = lang === "da" ? semesterDa || semester : semester;

      return currentSemester || currentYear;
    };

    const getCurrentDegree = (el: HTMLElement) => {
      const year = el.dataset.year || "";
      const yearDa = el.dataset.yearDa || "";
      const currentYear = lang === "da" ? yearDa || year : year;
      const parts = currentYear
        .split("·")
        .map((part) => part.trim())
        .filter(Boolean);

      return parts[parts.length - 1] || "";
    };

    document.querySelectorAll(".card-period").forEach((periodEl) => {
      const element = periodEl as HTMLElement;
      element.textContent = getCurrentPeriod(element);
    });

    document.querySelectorAll(".case-tile-degree").forEach((degreeEl) => {
      const element = degreeEl as HTMLElement;
      element.textContent = getCurrentDegree(element);
    });
  };

  applyCardTranslations(getLang());

  document.addEventListener("astro:page-load", () => {
    applyCardTranslations(getLang());
  });

  window.addEventListener("langchange", (event: Event) => {
    const customEvent = event as CustomEvent;
    const lang = customEvent.detail?.lang || getLang();
    applyCardTranslations(lang);
  });
</script>

<style>
  .case-tile {
    display: flex;
    min-width: 0;
  }

  .case-tile-inner {
    display: flex;
    flex-direction: column;
    width: 100%;
    overflow: hidden;
    border-radius: 1.5rem;
    border: 1px solid #bfb7b0;
    background: linear-gradient(to bottom right, #f5f5f5, #f0ebe6);
    color: #1a1a1a;
    text-decoration: none;
    transition:
      transform 300ms ease-in-out,
      border-color 300ms ease-in-out;
  }

  a.case-tile-inner:hover {
    transform: translateY(-4px);
    border-color: #8f8882;
  }

  a.case-tile-inner:focus-visible {
    outline: 3px solid #375567;
    outline-offset: 3px;
  }

  .case-tile-media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: #deebef;
  }

  .case-tile-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms ease-in-out;
  }

  a.case-tile-inner:hover .case-tile-img {
    transform: scale(1.03);
  }

  @media (min-width: 1024px) {
    .case-tile-media {
      aspect-ratio: auto;
      flex: 1 1 auto;
      min-height: 13rem;
    }
  }

  .case-tile-body {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.1rem 1.25rem 1.25rem;
    border-top: 1px solid #d8d2cc;
  }

  .case-tile-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
  }

  .case-tile-degree {
    display: inline-flex;
    align-items: center;
    border-radius: 9999px;
    background: #375567;
    color: #f5f5f5;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.2;
    padding: 0.3rem 0.7rem;
    text-transform: uppercase;
  }

  .case-tile-degree:empty {
    display: none;
  }

  .case-tile-period {
    font-size: 0.85rem;
    color: #4b4b4b;
  }

  .case-tile-title {
    font-family: var(--font-garamond);
    font-style: italic;
    font-weight: 600;
    font-size: 1.5rem;
    line-height: 1.15;
    color: #1a1a1a;
  }

  .case-tile-foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .case-tile-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .case-tile-chip {
    border-radius: 9999px;
    border: 1px solid #c0d7e1;
    background: #deebef;
    color: #2f3f4c;
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.2;
    padding: 0.3rem 0.65rem;
    white-space: nowrap;
  }

  .case-tile-arrow {
    flex-shrink: 0;
    font-size: 1.4rem;
    line-height: 1;
    color: #375567;
    transition: transform 300ms ease-in-out;
  }

  a.case-tile-inner:hover .case-tile-arrow {
    transform: translateX(4px);
  }

  .case-tile[data-inactive="true"] .case-tile-inner {
    cursor: default;
  }

  html.has-js body:not(.reduce-motion) #project-cards > li {
    opacity: 0;
    transform: translate3d(0, 1.25rem, 0);
    will-change: transform, opacity;
  }

  body.calm-mode .case-tile-degree {
    background: #4a637a;
  }

  body.calm-mode .case-tile-arrow {
    color: #4a637a;
  }

  body.dark .case-tile-inner {
    border-color: var(--dark-border);
    background: linear-gradient(to bottom right, var(--dark-gradient-start), var(--dark-gradient-end));
    color: var(--text-on-dark);
  }

  body.dark a.case-tile-inner:hover {
    border-color: var(--dark-border-strong);
  }

  body.dark a.case-tile-inner:focus-visible {
    outline-color: var(--brand-primary-soft);
  }

  body.dark .case-tile-body {
    border-color: var(--dark-border);
  }

  body.dark .case-tile-title {
    color: var(--text-on-dark);
  }

  body.dark .case-tile-period {
    color: var(--text-on-dark-soft);
  }

  body.dark .case-tile-degree {
    background: rgba(192, 215, 225, 0.2);
    color: var(--text-on-dark);
  }

  body.dark .case-tile-chip {
    border-color: rgba(192, 215, 225, 0.3);
    background: rgba(192, 215, 225, 0.12);
    color: var(--text-on-dark);
  }

  body.dark .case-tile-arrow {
    color: var(--brand-primary-soft);
  }
</style>
