---
import Header from "../components/Header.astro";
import { translations } from "../i18n/translations";
import Footer from "../components/Footer.astro";
import ScrollToTop from "../components/ScrollToTop.astro";
import AccessibilityPanel from "../components/AccessibilityPanel.astro";
import "../styles/tailwind.css";
import "../styles/global.css";
const siteUrl = "https://sararingkow.dk/";
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const socialImageUrl = new URL("/images/hero_image.webp", siteUrl).toString();
const pageTitle = Astro.props.title ?? "Sara Ringkow Petersen | UX/UI & Digital Accessibility";
const pageDescription =
  Astro.props.description ?? "UX/UI design, digital accessibility and inclusive web design by Sara Ringkow Petersen in Denmark.";
const pageType = Astro.props.pageType ?? "website";
const socialImageAlt = Astro.props.socialImageAlt ?? "Sara Ringkow Petersen — multimedia designer specialising in UX/UI and digital accessibility";
const additionalSchema = Astro.props.schema;

const schemamarkup = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Sara Ringkow Petersen",
  url: "https://sararingkow.dk/",
  email: "sara.ringkow@gmail.com",
  phone: "+45 42 42 88 07",
  image: "https://sararingkow.dk/images/pfp2.webp",
  jobTitle: "Concept Developer & Multimedia- and UX/UI Designer",
  description:
    "Multimedia Designer and Concept Developer based in Denmark, specialising in UX/UI design, web design, digital accessibility, and inclusive design.",
  knowsAbout: [
    "UX Design",
    "UI Design",
    "Accessibility",
    "Inclusive Design",
    "Accessible Web Design",
    "Web Design",
    "Visual Communication",
    "Digital Prototyping",
    "Astro",
    "Tailwind CSS",
    "JavaScript",
    "TypeScript",
    "Figma",
    "Concept Development",
  ],
  alumniOf: [
    { "@type": "EducationalOrganization", name: "Copenhagen School of Design and Technology (KEA)", description: "Multimedia Design" },
    { "@type": "EducationalOrganization", name: "Academy of Technologies and Business (Zealand)", description: "Digital Concept Development" },
  ],
  address: { "@type": "PostalAddress", addressCountry: "DK" },
  sameAs: [
    "https://www.linkedin.com/in/sara-ringkow-petersen-49830b264/",
    "https://github.com/sararpetersen",
    "https://www.instagram.com/srp_portfolio/",
    "https://www.facebook.com/profile.php?id=61558070190613",
    "https://sararingkow.dk/",
  ],
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-7RVC68SPR6"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", "G-7RVC68SPR6");
    </script>

    <!-- Meta Pixel Code -->
    <script is:inline>
      !(function (f, b, e, v, n, t, s) {
        if (f.fbq) return;
        n = f.fbq = function () {
          n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
        };
        if (!f._fbq) f._fbq = n;
        n.push = n;
        n.loaded = true;
        n.version = "2.0";
        n.queue = [];
        t = b.createElement(e);
        t.async = true;
        t.src = v;
        s = b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t, s);
      })(window, document, "script", "https://connect.facebook.net/en_US/fbevents.js");
      fbq("init", "1687802475627425");
      fbq("track", "PageView");
    </script>
    <!-- End Meta Pixel Code -->

    <script is:inline>
      (() => {
        const root = document.documentElement;

        try {
          if (localStorage.getItem("largeTextEnabled") === "true") root.classList.add("text-large");
          if (localStorage.getItem("readableFontEnabled") === "true") {
            root.classList.add("readable-font");
          } else if (localStorage.getItem("verdanaFontEnabled") === "true") {
            root.classList.add("verdana-font");
          } else if (localStorage.getItem("opendyslexicFontEnabled") === "true") {
            root.classList.add("opendyslexic-font");
          }
        } catch {
          // Keep first paint resilient if storage is unavailable.
        }
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content="Sara Ringkow Petersen" />
    <meta name="robots" content="index, follow" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:type" content={pageType} />
    <meta property="og:title" content={Astro.props.ogtitle ?? pageTitle} />
    <meta property="og:description" content={Astro.props.ogdescription ?? pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta property="og:site_name" content="SRP Portfolio" />
    <meta name="facebook-domain-verification" content="okjextzfsj20oepxg1f382yewajyj4" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={Astro.props.ogtitle ?? pageTitle} />
    <meta name="twitter:description" content={Astro.props.ogdescription ?? pageDescription} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="preload" href="/fonts/nikumaru/07NikumaruFont-latin.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/almarai/almarai-300.ttf" as="font" type="font/ttf" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/almarai/almarai-400.ttf" as="font" type="font/ttf" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/almarai/almarai-700.ttf" as="font" type="font/ttf" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/almarai/almarai-800.ttf" as="font" type="font/ttf" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/cormorant-garamond/cormorant-garamond-400.ttf" as="font" type="font/ttf" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/cormorant-garamond/cormorant-garamond-600.ttf" as="font" type="font/ttf" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/cormorant-garamond/cormorant-garamond-700.ttf" as="font" type="font/ttf" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/cormorant-garamond/cormorant-garamond-400-italic.ttf" as="font" type="font/ttf" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/cormorant-garamond/cormorant-garamond-600-italic.ttf" as="font" type="font/ttf" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/cormorant-garamond/cormorant-garamond-700-italic.ttf" as="font" type="font/ttf" crossorigin="anonymous" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schemamarkup)} />
    {additionalSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(additionalSchema)} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400;1,700&display=optional" rel="stylesheet" />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400;1,700&display=optional"
        rel="stylesheet"
      />
    </noscript>

    <!-- i18n: Language switching. The text itself lives in src/i18n/translations.ts. -->
    <script is:inline define:vars={{ translations }}>
      window.__i18n = (function () {
        var t = translations;

        function apply(lang) {
          var currentYear = new Date().getFullYear();
          document.querySelectorAll("[data-i18n]").forEach(function (el) {
            var key = el.getAttribute("data-i18n");
            if (t[lang] && t[lang][key] !== undefined) {
              el.innerHTML = t[lang][key].replace(/\{year\}/g, currentYear);
            }
          });
          // Same idea as data-i18n, but for attributes: [data-i18n] only ever touches
          // innerHTML, so aria-label/data-tooltip text was staying English in Danish mode
          // no matter what the visible text said.
          document.querySelectorAll("[data-i18n-aria]").forEach(function (el) {
            var key = el.getAttribute("data-i18n-aria");
            if (t[lang] && t[lang][key] !== undefined) {
              el.setAttribute("aria-label", t[lang][key]);
            }
          });
          document.querySelectorAll("[data-aria-en][data-aria-da]").forEach(function (el) {
            el.setAttribute("aria-label", el.getAttribute(lang === "da" ? "data-aria-da" : "data-aria-en"));
          });
          document.querySelectorAll("[data-i18n-placeholder]").forEach(function (el) {
            var key = el.getAttribute("data-i18n-placeholder");
            if (t[lang] && t[lang][key] !== undefined) {
              el.setAttribute("placeholder", t[lang][key]);
            }
          });
          document.querySelectorAll("[data-i18n-tooltip]").forEach(function (el) {
            var key = el.getAttribute("data-i18n-tooltip");
            if (t[lang] && t[lang][key] !== undefined) {
              el.setAttribute("data-tooltip", t[lang][key]);
            }
          });
          document.documentElement.lang = lang === "da" ? "da" : "en";
          var enBtn = document.getElementById("lang-toggle-en");
          var daBtn = document.getElementById("lang-toggle-da");
          if (enBtn && daBtn) {
            enBtn.setAttribute("aria-pressed", lang === "en" ? "true" : "false");
            daBtn.setAttribute("aria-pressed", lang === "da" ? "true" : "false");
          }
        }

        return {
          apply: apply,
          setLang: function (lang) {
            localStorage.setItem("lang", lang);
            apply(lang);
            window.dispatchEvent(new CustomEvent("langchange", { detail: { lang: lang } }));
          },
          getLang: function () {
            return localStorage.getItem("lang") || "en";
          },
        };
      })();
    </script>
  </head>
  <body class="site-shell bg-gray-50">
    <noscript>
      <img
        height="1"
        width="1"
        class="absolute"
        style="display:none"
        src="https://www.facebook.com/tr?id=1687802475627425&ev=PageView&noscript=1"
        alt=""
      />
    </noscript>
    <script is:inline>
      (() => {
        try {
          const body = document.body;
          const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
          const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
          const darkSetting = localStorage.getItem("darkModeEnabled");
          const motionSetting = localStorage.getItem("motionReductionEnabled");

          body.classList.toggle("dark", darkSetting === null ? prefersDark : darkSetting === "true");
          body.classList.toggle("reduce-motion", motionSetting === null ? prefersReducedMotion : motionSetting === "true");
          body.classList.toggle("calm-mode", localStorage.getItem("calmModeEnabled") === "true");
          body.classList.toggle("focus-mode", localStorage.getItem("focusModeEnabled") === "true");
          const cvdSetting = localStorage.getItem("cvdSimulation");
          if (cvdSetting && cvdSetting !== "off") body.classList.add("cvd-" + cvdSetting);
        } catch {
          // Preference classes are progressive enhancement.
        }
      })();
    </script>
    <!-- Colour-vision simulation filters, used by the "Colour vision simulation" panel setting.
         Kept hidden and out of the accessible tree — these are rendering filters, not content. -->
    <svg aria-hidden="true" focusable="false" style="position: absolute; width: 0; height: 0; overflow: hidden;">
      <defs>
        <filter id="cvd-protanopia-filter" color-interpolation-filters="sRGB">
          <feColorMatrix type="matrix" values="0.567 0.433 0 0 0  0.558 0.442 0 0 0  0 0.242 0.758 0 0  0 0 0 1 0"></feColorMatrix>
        </filter>
        <filter id="cvd-deuteranopia-filter" color-interpolation-filters="sRGB">
          <feColorMatrix type="matrix" values="0.625 0.375 0 0 0  0.7 0.3 0 0 0  0 0.3 0.7 0 0  0 0 0 1 0"></feColorMatrix>
        </filter>
        <filter id="cvd-tritanopia-filter" color-interpolation-filters="sRGB">
          <feColorMatrix type="matrix" values="0.95 0.05 0 0 0  0 0.433 0.567 0 0  0 0.475 0.525 0 0  0 0 0 1 0"></feColorMatrix>
        </filter>
      </defs>
    </svg>
    <nav aria-label="Skip links" data-i18n-aria="skiplinks.aria">
      <a href="#main-content" class="skip-link transition duration-300 ease-in-out font-semibold">Skip to main content</a>
    </nav>
    <Header />

    <main id="main-content" tabindex="-1" class="site-main scroll-vertical overflow-x-hidden">
      <slot />
    </main>

    <ScrollToTop />
    <div>
      <Footer />
    </div>
    <AccessibilityPanel />
    <!-- Holds sr-only tooltip descriptions out of the document's reading flow. `hidden`
         (unlike sr-only) removes it from the paragraph a trigger sits in, while
         aria-describedby still resolves against a hidden element. -->
    <div id="tooltip-descriptions" hidden></div>
    <script is:inline>
      (() => {
        const lang = window.__i18n.getLang();
        // English is already server-rendered. Only replace content when Danish
        // is selected, and do it synchronously before the first paint.
        if (lang !== "en") {
          window.__i18n.apply(lang);
        } else {
          document.documentElement.lang = "en";
        }
      })();
    </script>
    {
      import.meta.env.DEV && (
        <script
          is:inline
          set:html={`(() => {
            if (!("PerformanceObserver" in window)) return;
            window.__layoutShifts = [];
            window.__flickerTrace = [];
            const record = (type, extra = {}) => {
              window.__flickerTrace.push({
                type,
                time: Math.round(performance.now()),
                scrollY: Math.round(window.scrollY),
                viewportTop: Math.round(window.visualViewport?.offsetTop || 0),
                viewportHeight: Math.round(window.visualViewport?.height || window.innerHeight),
                activeElement: document.activeElement?.id || document.activeElement?.tagName || null,
                ...extra,
              });
              if (window.__flickerTrace.length > 500) window.__flickerTrace.shift();
            };
            window.addEventListener("scroll", () => record("scroll"), { passive: true });
            window.visualViewport?.addEventListener("resize", () => record("viewport-resize"), { passive: true });
            window.visualViewport?.addEventListener("scroll", () => record("viewport-scroll"), { passive: true });
            document.addEventListener("focusin", (event) => record("focus", { target: event.target?.id || event.target?.tagName || null }));
            document.fonts?.addEventListener("loading", () => record("fonts-loading"));
            document.fonts?.addEventListener("loadingdone", (event) => record("fonts-loaded", {
              faces: Array.from(event.fontfaces || []).map((face) => ({
                family: face.family,
                weight: face.weight,
                style: face.style,
                status: face.status,
              })),
            }));
            record("start", { fonts: document.fonts?.status || "unknown" });
            new PerformanceObserver((list) => {
              for (const entry of list.getEntries()) {
                if (entry.hadRecentInput || entry.value === 0) continue;
                const shift = {
                  value: entry.value,
                  scrollY: window.scrollY,
                  sources: (entry.sources || []).map(({ node, previousRect, currentRect }) => ({
                    element: node instanceof Element
                      ? node.id ? "#" + node.id : node.className ? node.tagName.toLowerCase() + "." + String(node.className).trim().replace(/\\s+/g, ".") : node.tagName.toLowerCase()
                      : "unknown",
                    previousRect,
                    currentRect,
                  })),
                };
                window.__layoutShifts.push(shift);
                record("layout-shift", { value: entry.value, sources: shift.sources.map((source) => source.element) });
                console.warn("[layout shift]", shift);
              }
            }).observe({ type: "layout-shift", buffered: true });
          })();`}
        />
      )
    }
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: 0.5rem;
    top: 0.5rem;
    z-index: 100;
    padding: 0.5rem 1rem;
    border-radius: 0.375rem;
    background: #2f3f4c;
    color: var(--text-on-dark, #f6f6f6);
    text-decoration: none;
    transform: translateY(-180%);
    transition:
      transform 0.2s ease,
      background-color 0.3s ease-in-out,
      color 0.3s ease-in-out;
  }

  .skip-link:hover {
    background: #375567;
    color: var(--text-on-dark, #f6f6f6);
  }

  .skip-link:focus,
  .skip-link:focus-visible {
    transform: translateY(0);
    outline: 2px solid var(--brand-primary-soft, #c0d7e1);
    outline-offset: 2px;
  }

  body.dark .skip-link {
    background: #f0f0f0;
    color: #1a1a1a;
    transition:
      transform 0.2s ease,
      background-color 0.3s ease-in-out,
      color 0.3s ease-in-out;
  }

  body.dark .skip-link:hover {
    background: var(--brand-primary-soft, #c0d7e1);
    color: #1a1a1a;
  }

  body.dark .skip-link:focus,
  body.dark .skip-link:focus-visible {
    outline: 2px solid #ff6f61;
    outline-offset: 2px;
  }

  /* When hinting, slide down to just below the accessibility bar (36px = h-9) */
  body.show-skip-link-hint .skip-link {
    transform: translateY(calc(36px + 0.5rem));
  }

  body.dark {
    background: var(--dark-bg);
    color: var(--text-on-dark);
    box-shadow: none;
  }

  /* Colour-vision simulation: approximates how the page looks under each condition.
     `filter` on body would make body a new containing block for every fixed-position
     descendant (header, accessibility bar, the panel itself), breaking their positioning
     site-wide. So the class still toggles on body (for JS state checks) but the filter is
     scoped to individual elements instead — none of which have fixed-position descendants
     of their own, so fixed positioning stays intact. The equivalent rules for the header/
     accessibility bar and footer live in Header.astro and Footer.astro respectively, since
     Astro's scoped CSS can't reach into another component's markup from here. The
     accessibility panel/FAB/overlay are deliberately excluded so the controls stay
     unfiltered and easy to use while simulating. */
  body.cvd-protanopia #main-content {
    filter: url(#cvd-protanopia-filter);
  }
  body.cvd-deuteranopia #main-content {
    filter: url(#cvd-deuteranopia-filter);
  }
  body.cvd-tritanopia #main-content {
    filter: url(#cvd-tritanopia-filter);
  }

  body.dark .toggle-switch {
    background-color: #4b5563;
  }
  body.dark .toggle-switch[aria-pressed="true"] {
    background-color: #94a3b8;
  }
  body.dark .toggle-circle {
    background-color: #f0f0f0;
  }
</style>

<script>
  // Briefly reveal the skip link for first-time visitors to improve discoverability.
  const skipHintSeenKey = "skipLinkHintSeen";
  if (localStorage.getItem(skipHintSeenKey) !== "true") {
    document.body.classList.add("show-skip-link-hint");
    setTimeout(() => {
      document.body.classList.remove("show-skip-link-hint");
      localStorage.setItem(skipHintSeenKey, "true");
    }, 2800);
  }
</script>

<script>
  // [data-tooltip] renders its text as CSS generated content (::after), which screen readers
  // don't reliably expose. Pair every tooltip trigger with a description and aria-describedby
  // so the same text reaches assistive tech, not just sighted hover/focus.
  //
  // Some [data-tooltip] elements (e.g. the .tooltip-term jargon spans inside translated
  // paragraphs) get their innerHTML rebuilt from scratch when the language toggles, which
  // silently drops whatever we appended here. Re-running this on langchange re-wires those.
  // Elements that survive the toggle instead (e.g. the lab badges, whose data-tooltip value
  // gets rewritten in place by apply()'s data-i18n-tooltip pass) keep their marker and stored
  // desc, so update the existing text rather than skipping — otherwise a translated tooltip
  // would never reach its aria-describedby description.
  //
  // Descriptions live in one shared, `hidden` container at the end of the body rather than
  // next to their trigger. For a jargon term inside a sentence (e.g. ".tooltip-term"), a
  // sibling span sits inside that sentence's reading flow, so it got read mid-paragraph as
  // if it were body copy, then read a second time as the description. `hidden` (unlike
  // sr-only) removes an element from the reading flow entirely, and aria-describedby still
  // resolves against a hidden element, so the description stays reachable either way.
  let tooltipDescCounter = 0;
  function wireTooltipDescriptions(): void {
    const store = document.getElementById("tooltip-descriptions");
    if (!store) return;
    document.querySelectorAll<HTMLElement>("[data-tooltip]").forEach((el) => {
      const text = el.getAttribute("data-tooltip");
      if (!text) return;

      const existingId = el.dataset.tooltipDescId;
      const existingDesc = existingId ? document.getElementById(existingId) : null;
      if (existingDesc) {
        if (existingDesc.textContent !== text) existingDesc.textContent = text;
        return;
      }

      const id = `tooltip-desc-${tooltipDescCounter++}`;
      const desc = document.createElement("span");
      desc.id = id;
      desc.textContent = text;
      store.appendChild(desc);
      el.dataset.tooltipDescId = id;

      const existing = el.getAttribute("aria-describedby");
      el.setAttribute("aria-describedby", existing ? `${existing} ${id}` : id);
    });
  }
  wireTooltipDescriptions();
  window.addEventListener("langchange", wireTooltipDescriptions);

  // WCAG 1.4.13: hover/focus-triggered content must be dismissible without moving the
  // pointer or focus away. Escape hides every open tooltip in place; it reappears on the
  // next hover/focus change.
  document.addEventListener("keydown", (e: KeyboardEvent) => {
    if (e.key !== "Escape") return;
    document.body.classList.add("tooltips-dismissed");
  });
  document.addEventListener("focusin", () => document.body.classList.remove("tooltips-dismissed"), true);
  document.addEventListener("mouseover", () => document.body.classList.remove("tooltips-dismissed"), true);
</script>
